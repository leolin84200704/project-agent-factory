{
  "autoMemoryEnabled": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": ".claude/hooks/validate-git-push.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(git reset*)",
            "command": ".claude/hooks/validate-git-destructive.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(git clean*)",
            "command": ".claude/hooks/validate-git-destructive.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": ".claude/hooks/remind-engineering-lessons.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": ".claude/hooks/validate-repo-language.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/protect-verification-assets.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Microsoft_365__(outlook_(create_draft|create_reply_draft|create_reply_all_draft|update_draft|send_mail|forward_mail)|teams_(send_chat_message|send_channel_message|reply_channel_message))|mcp__claude_ai_Slack__slack_(send_message|send_message_draft|schedule_message)|mcp__claude_ai_Atlassian_MCP__addOrEditJiraIssueComment",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/validate-outbound-placeholders.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
