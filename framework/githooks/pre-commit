#!/usr/bin/env bash
# Shared git pre-commit guards, version-controlled in the factory and wired via
# `core.hooksPath` so they survive a fresh clone.
#
# Why this file exists: these guards used to live in one repo's `.git/hooks/`.
# That directory cannot be committed, is invisible when browsing the repo, and
# disappears on every fresh clone — so a rule that had already been broken three
# times was protected by a file nobody could see and nobody would get.
#
# Two constraints shape the design:
#
# 1. It must CHAIN to the repo's own hook. Setting `core.hooksPath` makes git
#    ignore `.git/hooks/` entirely, which would silently disable third-party
#    hooks — git-lfs installs pre-push/post-commit/post-merge/post-checkout that
#    way, and killing them corrupts LFS pointers. The repo's own hook runs first
#    and its failure is honoured.
# 2. It must be REPO-AWARE. One file is wired from many repos, so every guard
#    decides for itself whether this repo is in scope, and does nothing when it
#    is not. A guard that fires where it was never agreed is a guard that gets
#    disabled.
#
# Override, only when intentional: git commit --no-verify

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$repo_root" ] || exit 0

# ---------- chain to the repo's own hook ----------
# `git rev-parse --git-path hooks` resolves to core.hooksPath once it is set —
# i.e. to THIS directory — so the real hooks dir must be built from --git-dir.
git_dir="$(git rev-parse --git-dir)"
local_hook="$git_dir/hooks/pre-commit"
if [ -x "$local_hook" ] && [ "$(cd "$(dirname "$local_hook")" && pwd)" != "$(cd "$(dirname "$0")" && pwd)" ]; then
  "$local_hook" "$@" || exit $?
fi

fail=0

# ---------- guard 1: config coupled with code ----------
# Scope: repos that ship a ConfigMap pair at the root. Discovered by shape, not
# hardcoded by name, so a repo opts in simply by having the files.
dev_yaml="$(ls "$repo_root"/*-config.yaml 2>/dev/null | head -1)"
prod_yaml="$(ls "$repo_root"/*-config-prod.yaml 2>/dev/null | head -1)"
# *-config.yaml also matches *-config-prod.yaml on some globs; make sure they differ.
[ "$dev_yaml" = "$prod_yaml" ] && dev_yaml="$(ls "$repo_root"/*-config.yaml 2>/dev/null | grep -v -- '-config-prod\.yaml$' | head -1)"

added_vars="$(git diff --cached --unified=0 -- '*.ts' '*.js' 2>/dev/null \
  | grep '^+' | grep -v '^+++' \
  | grep -oE 'process\.env\.[A-Za-z_][A-Za-z0-9_]*' \
  | sed 's/process\.env\.//' | sort -u || true)"

# The guard is opt-in by shape, and that is deliberate — but a repo can opt OUT
# by accident. When the config files are renamed or moved (a repo migrating to
# kustomize, say), this glob starts matching nothing and the guard passes every
# commit unconditionally, with a green result indistinguishable from a real one.
# Observed: one repo where the ConfigMap became a build-time export that exists
# only inside a CI workspace, so no developer checkout has ever had the file —
# the guard had been inert for an unknown number of commits and was only noticed
# when someone walked the checklist by hand.
#
# A warning rather than a failure, on purpose: a library repo with no deployment
# config at all is a legitimate case, and failing it would be a false positive on
# every commit that touches process.env. But staying silent when there IS
# something to check and nowhere to check it is how a mechanised rule decays back
# into prose without anyone noticing.
if [ -n "$added_vars" ] && { [ -z "$dev_yaml" ] || [ -z "$prod_yaml" ]; }; then
  echo ""
  echo "! [guard 1] SKIPPED — could not find the ConfigMap pair to check against"
  echo "  staged code adds: $(echo "$added_vars" | tr '\n' ' ')"
  echo "  looked for: $repo_root/*-config.yaml and $repo_root/*-config-prod.yaml"
  echo "  If this repo declares deployment config somewhere else, this guard is"
  echo "  not protecting it — point it at the real location or drop the rule."
fi

if [ -n "$dev_yaml" ] && [ -n "$prod_yaml" ]; then
  if [ -n "$added_vars" ]; then
    yaml_has_key() { grep -qE "^[[:space:]]+$1:" "$2" 2>/dev/null; }
    missing=""
    for v in $added_vars; do
      miss=""
      yaml_has_key "$v" "$dev_yaml"  || miss="$miss dev"
      yaml_has_key "$v" "$prod_yaml" || miss="$miss prod"
      [ -n "$miss" ] && missing="$missing
  - $v   (missing in:$miss)"
    done
    if [ -n "$missing" ]; then
      echo ""
      echo "x [guard 1] config coupled with code"
      echo "These process.env vars are referenced by staged code but absent from the ConfigMap:"
      echo "$missing"
      echo "Add them to the data: block of BOTH:"
      echo "  $dev_yaml"
      echo "  $prod_yaml"
      fail=1
    fi
  fi
fi

# ---------- guard 2: no CJK in code ----------
# Applies everywhere: source, comments and migrations stay English. Markdown and
# docs are exempt — a doc's language follows the repo owner's convention, which
# is a human judgment; code files carry no such discretion.
cjk_hits="$(git diff --cached --unified=0 -- '*.ts' '*.js' '*.sql' 2>/dev/null \
  | grep '^+' | grep -v '^+++' \
  | perl -CSD -ne 'print if /[\x{2e80}-\x{9fff}\x{f900}-\x{faff}\x{ff00}-\x{ffef}]/' || true)"

if [ -n "$cjk_hits" ]; then
  echo ""
  echo "x [guard 2] no CJK in code"
  echo "These staged additions contain CJK characters (source/comments/migrations must be English):"
  echo "$cjk_hits" | sed 's/^/    /'
  fail=1
fi

# ---------- guard 3: a memory file must not lose entries or links ----------
# Scope: agent instance repos, discovered by shape (an LTM directory plus an STM
# store), never by name.
#
# Why: on 2026-08-18 an LTM file was regenerated from a partial base. It stayed
# well-formed — same 14 sections, same frontmatter keys — while dropping 49 of
# its 90 `links:` and two entries whose only copy was that file. Nothing in the
# pipeline noticed: `memory_scoring.py` only ever ADDS links and recomputes
# `score`, so a narrowed list stays narrow and looks freshly maintained. The
# regeneration sat uncommitted for a day and would have landed on the next
# `git add -A`.
#
# Distillation legitimately rewrites prose, merges entries and deletes noise, so
# this does not diff content. It counts the two things that only ever grow in
# normal operation, and asks for an explicit override when they shrink.
if [ -d "$repo_root/long-term-memory" ] && [ -d "$repo_root/storage/short_term_memory" ]; then
  count_entries() { grep -cE '^### \*\*\[\[' 2>/dev/null || true; }
  count_links() {
    awk '/^links:/{f=1;next} /^[a-z_]+:/{f=0} f&&/^- /{n++} END{print n+0}' 2>/dev/null || true
  }
  entry_ids() { grep -oE '^### \*\*\[\[[^]]*\]\]' 2>/dev/null | sed 's/^### \*\*\[\[//;s/\]\]$//' | sort -u || true; }

  staged_memory="$(git diff --cached --name-only --diff-filter=M -- 'long-term-memory/*.md' 2>/dev/null || true)"
  for f in $staged_memory; do
    git cat-file -e "HEAD:$f" 2>/dev/null || continue
    was_e="$(git show "HEAD:$f" | count_entries)"; now_e="$(git show ":$f" | count_entries)"
    was_l="$(git show "HEAD:$f" | count_links)";   now_l="$(git show ":$f" | count_links)"
    lost="$(comm -23 <(git show "HEAD:$f" | entry_ids) <(git show ":$f" | entry_ids) | tr '\n' ' ')"
    # Counts alone are not enough: the 2026-08-18 file had MORE entries than the
    # committed one and still dropped VP-16720. An id that disappears is the
    # signal; the counts catch the rest.
    [ "$now_e" -ge "$was_e" ] && [ "$now_l" -ge "$was_l" ] && [ -z "$lost" ] && continue

    echo ""
    echo "x [guard 3] memory file loses content: $f"
    [ "$now_e" -lt "$was_e" ] && echo "    entries: $was_e -> $now_e"
    [ "$now_l" -lt "$was_l" ] && echo "    links:   $was_l -> $now_l"
    [ -n "$lost" ] && echo "    entries no longer present: $lost"
    echo "    An entry can be the only surviving copy of an incident — check it exists"
    echo "    elsewhere (STM, journal, another LTM file) before letting this through."
    echo "    A deliberate merge or rename trips this too; that is what --no-verify is for."
    fail=1
  done
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "If the content is genuinely intentional:  git commit --no-verify"
  echo ""
  exit 1
fi
exit 0
