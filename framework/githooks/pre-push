#!/usr/bin/env bash
# Shared git pre-push guard — see pre-commit in this directory for why these
# live in the factory and are wired via core.hooksPath.
#
# Override, only when intentional: git push --no-verify

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$repo_root" ] || exit 0

# ---------- chain to the repo's own hook ----------
# git-lfs installs its own pre-push here; skipping it corrupts LFS pointers.
git_dir="$(git rev-parse --git-dir)"
local_hook="$git_dir/hooks/pre-push"
if [ -x "$local_hook" ] && [ "$(cd "$(dirname "$local_hook")" && pwd)" != "$(cd "$(dirname "$0")" && pwd)" ]; then
  "$local_hook" "$@" || exit $?
fi

# ── ADAPT PER INSTANCE ───────────────────────────────────────────
# Repos where a build must pass before pushing, matched on the origin repo name.
# Deliberately opt-in rather than "any repo with a build script": forcing a build
# on every push in every JS repo is a workflow change nobody agreed to, and a
# guard that fires where it was not wanted is a guard that gets turned off.
# 2026-09-11 (Leo): every LIS NestJS service, so the DI boot smoke that follows
# the build covers them all. Repos with a build but no NestJS stay out.
BUILD_GATE_REPOS='lis-backend-emr-v2|LIS-transformer-v2|LIS-transformer|LIS-backend-coreSamples|LIS-backend-dashboard|LIS-backend-results-web|LIS-backend-results-core|LIS-backend-results-grpc|LIS-Sample|LIS-interactive-report|LIS-notification-center|LIS-setting-consumer|LIS-Shipping|Portal-Calendar'
# ─────────────────────────────────────────────────────────────────

origin="$(git -C "$repo_root" remote get-url origin 2>/dev/null)"
repo_name="$(basename "${origin%.git}")"
echo "$repo_name" | grep -qE "^($BUILD_GATE_REPOS)$" || exit 0

cd "$repo_root" || exit 0
log_prefix="/tmp/${repo_name}-prepush"

# prisma is regenerated first only if this repo actually uses it: switching
# branches leaves the generated client matching the OTHER branch's schema, and
# the resulting type errors look exactly like someone else's pre-existing
# breakage. That misattribution is the whole reason this gate exists.
# Prefer the repo's own generate script when it has one: multi-schema repos
# (measured 2026-09-11: one with 8 schemas, one with 6) generate every client
# from that script, and a bare `npx prisma generate` only refreshes the default
# schema — leaving the other clients on the previous branch's shape, which is
# the exact misattribution described above.
if [ -f "$repo_root/prisma/schema.prisma" ] || grep -q '"prisma"' "$repo_root/package.json" 2>/dev/null; then
  gen_cmd="npx prisma generate"
  for script in prisma:generate generate:prisma prisma:generate:all; do
    if grep -qE "\"$script\"[[:space:]]*:" "$repo_root/package.json" 2>/dev/null; then
      gen_cmd="npm run $script"; break
    fi
  done
  echo "[pre-push] $gen_cmd ..."
  if ! $gen_cmd > "$log_prefix-prisma.log" 2>&1; then
    echo ""
    echo "x [pre-push] prisma generate failed — not pushing"
    tail -n 20 "$log_prefix-prisma.log"
    echo "log: $log_prefix-prisma.log     skip: git push --no-verify"
    exit 1
  fi
fi

if [ -f "$repo_root/package.json" ] && grep -q '"build"' "$repo_root/package.json" 2>/dev/null; then
  echo "[pre-push] build ..."
  if ! npm run build > "$log_prefix-build.log" 2>&1; then
    echo ""
    echo "x [pre-push] build failed — not pushing."
    echo "  Assume you caused it. Check branch switches, untracked files carried"
    echo "  over, generated code (prisma client, proto), and node_modules state"
    echo "  before concluding it is pre-existing."
    tail -n 30 "$log_prefix-build.log"
    echo "log: $log_prefix-build.log     skip: git push --no-verify"
    exit 1
  fi
  echo "[pre-push] build OK"

  # ---------- Nest DI boot smoke ----------
  # 2026-09-10: this very build gate passed and both new pods crash-looped on
  # boot. An @Injectable constructor param typed as an interface (or merely
  # marked `?`) is a REQUIRED provider registered under `Object` as far as Nest
  # is concerned; tsc cannot see that, and unit specs that `new` the service by
  # hand or stub the new provider never ask the real injector. Booting the
  # compiled app for a few seconds does: the injector reports an unresolved
  # dependency within ~1 s, long before any database or broker is needed.
  # Scope: repos already in the gate list whose package.json depends on
  # @nestjs/core. The smoke runs with an empty environment (see lib/).
  if grep -q '"@nestjs/core"' "$repo_root/package.json" 2>/dev/null; then
    echo "[pre-push] nest DI smoke ..."
    if ! DI_SMOKE_LOG="$log_prefix-di-smoke.log" bash "$(dirname "$0")/lib/nest-di-smoke.sh" "$repo_root"; then
      echo ""
      echo "x [pre-push] Nest DI smoke did not pass — not pushing."
      echo "  The build compiled; the dependency graph did not resolve (or gave no"
      echo "  sign of running). Fix the provider, then add a spec that compiles the"
      echo "  REAL module through Test.createTestingModule so the next one is caught"
      echo "  by jest, not by this gate."
      echo "log: $log_prefix-di-smoke.log     skip (humans only — the agent's push hook refuses --no-verify): git push --no-verify"
      exit 1
    fi
  fi
fi

# ---------- related unit tests ----------
# "Test before push" (ENGINEERING-LESSONS) lived only as prose until 2026-09-18:
# the build gate proves the code compiles, the DI smoke proves the graph
# resolves, and neither proves a single branch of the new logic behaves.
# INCIDENT-20260601 was a SFTP patch pushed on a green build alone.
# This runs the jest suites that import the TypeScript changed since the branch
# left main (`jest --findRelatedTests`), not the whole suite: measured
# 2026-09-18, one emr-v2 service file -> 7 suites in 6 s; a transformer-v2 hub
# file -> 33 suites in 60 s; the full suites are minutes. Opt-in by repo name,
# like the build gate, and for the same reason.
TEST_GATE_REPOS='lis-backend-emr-v2|LIS-transformer-v2'
if echo "$repo_name" | grep -qE "^($TEST_GATE_REPOS)$" \
   && [ -f "$repo_root/package.json" ] && grep -q '"jest"' "$repo_root/package.json" 2>/dev/null; then
  # Base = where this branch left the default branch. origin/main is preferred
  # over the push's remote sha (stdin) because a first push of a new branch has
  # no remote sha, and a chained repo-local hook may already have drained stdin.
  test_base=""
  for ref in origin/main origin/master; do
    if git rev-parse -q --verify "$ref^{commit}" >/dev/null 2>&1; then
      test_base="$(git merge-base HEAD "$ref" 2>/dev/null)" && [ -n "$test_base" ] && break
    fi
  done
  [ -z "$test_base" ] && test_base="$(git rev-parse -q --verify '@{upstream}' 2>/dev/null)"

  if [ -z "$test_base" ]; then
    echo "[pre-push] related tests: no origin/main, origin/master or upstream to diff against — skipped"
  else
    # Source and spec files under the code roots; specs select themselves.
    # Integration / e2e specs need live infrastructure and stay out, as do
    # declaration files and files deleted on the branch.
    changed_ts="$(git diff --name-only --diff-filter=ACMR "$test_base" HEAD -- '*.ts' 2>/dev/null \
      | grep -E '^(src|apps|libs)/' \
      | grep -vE '\.(integration|e2e)[-.]spec\.ts$|\.e2e-spec\.ts$|\.d\.ts$' \
      | while IFS= read -r f; do [ -f "$repo_root/$f" ] && printf '%s\n' "$f"; done)"
    if [ -z "$changed_ts" ]; then
      echo "[pre-push] related tests: no TypeScript changed since $(git rev-parse --short "$test_base") — skipped"
    else
      # `npm test` would run the repo's pretest (emr-v2: prisma generate for the
      # test schema); calling jest directly skips it, so run it here when present.
      if grep -qE '"pretest"[[:space:]]*:' "$repo_root/package.json" 2>/dev/null; then
        if ! npm run -s pretest > "$log_prefix-pretest.log" 2>&1; then
          echo ""
          echo "x [pre-push] npm run pretest failed — not pushing"
          tail -n 20 "$log_prefix-pretest.log"
          echo "log: $log_prefix-pretest.log"
          exit 1
        fi
      fi
      jest_bin="npx jest"
      [ -x "$repo_root/node_modules/.bin/jest" ] && jest_bin="$repo_root/node_modules/.bin/jest"
      n_changed=$(printf '%s\n' "$changed_ts" | grep -c .)
      echo "[pre-push] related tests for $n_changed changed .ts file(s) since $(git rev-parse --short "$test_base") ..."
      # shellcheck disable=SC2086
      if ! printf '%s\n' "$changed_ts" | xargs $jest_bin --ci --passWithNoTests --findRelatedTests > "$log_prefix-tests.log" 2>&1; then
        echo ""
        echo "x [pre-push] related unit tests failed — not pushing."
        echo "  These suites import code this branch changed. A spec that no longer"
        echo "  compiles counts: it means the contract it pinned moved and nothing"
        echo "  re-pinned it. Fix the code or the spec; do not delete the assertion."
        grep -E '^(FAIL|Tests:|Test Suites:)' "$log_prefix-tests.log" | head -n 20
        echo "log: $log_prefix-tests.log     skip (humans only — the agent's push hook refuses --no-verify): git push --no-verify"
        exit 1
      fi
      grep -E '^(Tests:|Test Suites:)' "$log_prefix-tests.log" | sed 's/^/[pre-push] /'
    fi
  fi
fi

exit 0
