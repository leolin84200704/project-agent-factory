{
  "version": 1,
  "zone": "autonomous",
  "default_branch": "main",
  "require_blind_review": true,
  "consensus": {
    "require_hmac": true,
    "allow_same_family_fallback": true
  },
  "dune_lint": {
    "enabled": true,
    "cjk_allow_globs": [
      "framework/hooks/*.sh",
      "framework/githooks/tests/**",
      "framework/scripts/eval.py",
      "framework/scripts/extract-*.py",
      "framework/scripts/test-retrieval.py"
    ]
  },
  "commands": {
    "unit_test": [
      "python3 framework/scripts/tests/memory-scoring-frontmatter.test.py",
      "python3 framework/checks/tests/test_dune_lint.py",
      "python3 framework/scripts/tests/test_paf_cli.py",
      "python3 framework/scripts/tests/test_paf_watcher.py",
      "python3 framework/scripts/tests/test_model_router.py",
      "bash framework/hooks/tests/validate-git-push.test.sh",
      "bash framework/hooks/tests/validate-outbound-placeholders.test.sh",
      "bash framework/hooks/tests/remind-engineering-lessons.test.sh",
      "bash framework/hooks/tests/protect-verification-assets.test.sh",
      "bash framework/githooks/tests/githooks.test.sh"
    ],
    "post_merge_check": [
      "python3 framework/scripts/tests/memory-scoring-frontmatter.test.py",
      "python3 framework/checks/tests/test_dune_lint.py",
      "python3 framework/scripts/tests/test_paf_cli.py",
      "python3 framework/scripts/tests/test_paf_watcher.py",
      "python3 framework/scripts/tests/test_model_router.py",
      "bash framework/hooks/tests/protect-verification-assets.test.sh"
    ]
  }
}
