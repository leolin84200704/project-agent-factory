#!/usr/bin/env python3
"""paf — Unified High-Trust Agent Factory CLI.

Shared operational engine for `project-agent-factory` and `personal-agent-factory`.

Commands:
  paf score            Rebuild memory scores, links, and clamped L2 `_index.md` + `journal/_index.md`
  paf lint-code        Run Dune Architecture deterministic static checks (`dune_lint.py`)
  paf verify           Execute `.agent-verify.json` deterministic gates and emit Verification Artifact
  paf record-review    Record SHA-pinned Blind Adversarial Reviewer receipt in `<git-common-dir>/paf-reviews/`
  paf check-consensus  Verify SHA-pinned heterogeneous dual-model consensus (`<!-- paf-consensus: ... -->`) on a PR
  paf post-consensus   Post a SHA-pinned consensus marker comment on a PR (and optionally auto-merge on approve)
  paf merge-consensus  Atomically merge a PR once heterogeneous dual-model consensus + CI pass, then verify post-merge
  paf init-consensus-key  Provision or rotate the 0600 local HMAC-SHA256 shared key (`~/.config/paf/consensus.key`)
  paf watch-prs        ETag/state-driven cross-model PR consensus reviewer, claim coordinator, and auto-merger
  paf install-watcher  Generate (and optionally load) macOS launchd StartInterval plist for `paf watch-prs`
  paf ship             Autonomous PR -> CI -> Consensus / Blind Review -> atomic merge -> post-merge verify -> auto-revert
  paf audit            Audit agent/product repos for manifest, `.agent-verify.json`, script drift, and index bloat
  paf garden           Run codebase hygiene checks (dune_lint, stale merged branches, unmerged proposals)
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any

FACTORY_ROOT = Path(__file__).resolve().parent.parent
MEMORY_SCORING_PATH = FACTORY_ROOT / "framework" / "scripts" / "memory_scoring.py"
PAF_WATCHER_PATH = FACTORY_ROOT / "framework" / "scripts" / "paf_watcher.py"
DUNE_LINT_PATH = FACTORY_ROOT / "framework" / "checks" / "dune_lint.py"
GIT_BIN = "/usr/bin/git" if os.path.isfile("/usr/bin/git") else "git"
RESTRICTED_PRIVATE_REPO = "mind" + "-" + "state"
GIT_LOCAL_ENV_VARS = (
    "GIT_DIR",
    "GIT_WORK_TREE",
    "GIT_INDEX_FILE",
    "GIT_COMMON_DIR",
    "GIT_OBJECT_DIRECTORY",
    "GIT_ALTERNATE_OBJECT_DIRECTORIES",
    "GIT_PREFIX",
)


def _clean_git_env(base_env: dict[str, str] | None = None) -> dict[str, str]:
    env = dict(base_env if base_env is not None else os.environ)
    for var in GIT_LOCAL_ENV_VARS:
        env.pop(var, None)
    return env


def _load_module(name: str, path: Path) -> Any:
    if name in sys.modules:
        return sys.modules[name]
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"Cannot load module {name} from {path}")
    mod = importlib.util.module_from_spec(spec)
    sys.modules[name] = mod
    spec.loader.exec_module(mod)
    return mod


def _watcher_mod() -> Any:
    return _load_module("paf_watcher", PAF_WATCHER_PATH)


def _resolve_session_id(cli_session_id: str | None = None) -> str:
    if cli_session_id and cli_session_id.strip():
        return cli_session_id.strip()
    for env_key in ("PAF_SESSION_ID", "CLAUDE_SESSION_ID", "AGY_CONVERSATION_ID"):
        val = os.environ.get(env_key, "").strip()
        if val:
            return val
    return ""


def _git(repo: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [GIT_BIN, *args],
        cwd=repo,
        env=_clean_git_env(),
        text=True,
        capture_output=True,
        check=check,
    )


def _git_common_dir(repo: Path) -> Path:
    res = _git(repo, "rev-parse", "--git-common-dir", check=False)
    if res.returncode == 0 and res.stdout.strip():
        raw = Path(res.stdout.strip())
        return (repo / raw).resolve() if not raw.is_absolute() else raw.resolve()
    return repo / ".git"


def _git_head_sha(repo: Path) -> str:
    res = _git(repo, "rev-parse", "HEAD", check=False)
    return res.stdout.strip() if res.returncode == 0 else "uncommitted"


def _git_branch(repo: Path) -> str:
    res = _git(repo, "rev-parse", "--abbrev-ref", "HEAD", check=False)
    return res.stdout.strip() if res.returncode == 0 else "unknown"


def _is_branch_checked_out_elsewhere(repo: Path, branch: str) -> bool:
    res = _git(repo, "worktree", "list", "--porcelain", check=False)
    if res.returncode != 0:
        return False
    repo_resolved = repo.resolve()
    cur_wt: Path | None = None
    target_ref = f"refs/heads/{branch}"
    for line in res.stdout.splitlines():
        if line.startswith("worktree "):
            cur_wt = Path(line[len("worktree ") :].strip()).resolve()
        elif line.startswith("branch ") and cur_wt is not None:
            ref = line[len("branch ") :].strip()
            if ref == target_ref and cur_wt != repo_resolved:
                return True
    return False


def _load_verify_config(repo: Path) -> dict[str, Any]:
    cfg_path = repo / ".agent-verify.json"
    if not cfg_path.is_file():
        raise FileNotFoundError(
            f"Missing {cfg_path}. Every High-Trust repo requires a `.agent-verify.json` contract."
        )
    cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
    zone = cfg.get("zone")
    if zone not in ("autonomous", "guarded"):
        raise ValueError(
            f"Invalid or missing 'zone' in {cfg_path}: expected 'autonomous' or 'guarded', got {zone!r}."
        )
    return cfg


def _resolve_staging_branches(cfg: dict[str, Any]) -> set[str]:
    raw_list = cfg.get("staging_branches")
    if isinstance(raw_list, list):
        return {str(b).strip() for b in raw_list if str(b).strip()}
    single = str(cfg.get("staging_branch") or "").strip()
    if single:
        return {single}
    return {"staging", "stage_test"}


GOVERNANCE_FILE_RE = re.compile(
    r"(^|/)(CORE\.md|AGENTS\.md|CLAUDE\.md|GEMINI\.md|WORK-LOOP\.md|PERMISSIONS\.md|FEEDBACK\.md|"
    r"\.agent-verify\.json|run-regression\.py|dune_lint\.py|paf_watcher\.py)$|"
    r"^bin/paf$|"
    r"(^|/)(\.claude/settings[^/]*\.json|\.gemini/settings[^/]*\.json|\.gemini/config/|"
    r"\.github/workflows/[^/]+\.ya?ml|eval-tasks/[^/]+\.md|"
    r"hooks/|githooks/|framework/githooks/|"
    r"scripts/dream\.md|DailyJob/|launchd/|"
    r"\.claude/skills/|\.gemini/skills/|skills/)"
)


def _governance_files_touched(repo: Path, pr_data: dict[str, Any] | None, base_branch: str) -> list[str]:
    pr_paths: list[str] = []
    expected_count: int | None = None
    if pr_data is not None:
        if pr_data.get("changedFiles") is not None:
            try:
                expected_count = int(pr_data["changedFiles"])
            except (TypeError, ValueError):
                expected_count = None
        if isinstance(pr_data.get("files"), list):
            for item in pr_data["files"]:
                if isinstance(item, dict) and item.get("path"):
                    pr_paths.append(str(item["path"]))
                elif isinstance(item, str) and item:
                    pr_paths.append(item)
    truncated = expected_count is not None and expected_count > len(pr_paths)
    paths: list[str] = list(pr_paths)
    if (not paths or truncated) and (repo / ".git").exists():
        for ref in (base_branch, f"origin/{base_branch}"):
            diff_res = _git(repo, "diff", "--name-only", f"{ref}...HEAD", check=False)
            if diff_res.returncode == 0 and diff_res.stdout.strip():
                git_paths = [line.strip() for line in diff_res.stdout.splitlines() if line.strip()]
                paths.extend(git_paths)
                if expected_count is not None and len(set(paths)) >= expected_count:
                    truncated = False
                break
    matched = sorted({p for p in paths if GOVERNANCE_FILE_RE.search(re.sub(r"^(?:\./)+", "", p))})
    if truncated:
        matched.append(f"<truncated-pr-files:{len(pr_paths)}/{expected_count}>")
    return matched


def _run_shell_step(repo: Path, stage: str, command: str, timeout_sec: int = 900) -> dict[str, Any]:
    t0 = time.monotonic()
    env = _clean_git_env()
    env["PAF_AUTONOMOUS"] = "1"
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    proc = subprocess.run(
        command,
        shell=True,
        cwd=repo,
        env=env,
        text=True,
        capture_output=True,
        timeout=timeout_sec,
        check=False,
    )
    dur = round(time.monotonic() - t0, 2)
    combined = ((proc.stdout or "") + ("\n" + proc.stderr if proc.stderr else "")).strip()
    tail_lines = combined.splitlines()[-35:]
    return {
        "stage": stage,
        "command": command,
        "exit_code": proc.returncode,
        "passed": proc.returncode == 0,
        "duration_sec": dur,
        "output_tail": "\n".join(tail_lines),
    }


def _render_verify_markdown(report: dict[str, Any], review: dict[str, Any] | None = None) -> str:
    status_str = "PASS" if report["overall_passed"] else "FAIL"
    lines = [
        "### Verification Artifact (`paf verify`)",
        "",
        f"- **Status**: `{status_str}`",
        f"- **Mode**: `{report['mode']}`",
        f"- **Zone**: `{report['zone']}`",
        f"- **Branch**: `{report['branch']}`",
        f"- **Commit SHA**: `{report['head_sha']}`",
        f"- **Timestamp (UTC)**: `{report['timestamp_utc']}`",
        "",
        "| Stage | Command | Result | Duration |",
        "|---|---|---|---|",
    ]
    for step in report["steps"]:
        cmd_clean = step["command"].replace("|", "\\|")
        res = "PASS" if step["passed"] else f"FAIL (exit {step['exit_code']})"
        lines.append(
            f"| `{step['stage']}` | `{cmd_clean}` | `{res}` | {step['duration_sec']:.2f}s |"
        )
    if review:
        lines += [
            "",
            "### Blind Adversarial Review Receipt",
            f"- **Verdict**: `{review.get('verdict')}`",
            f"- **Reviewer**: `{review.get('reviewer')}`",
            f"- **Verified Commit**: `{review.get('head_sha')}`",
            f"- **Summary**: {review.get('summary', '')}",
        ]
    lines.append("")
    return "\n".join(lines)


def execute_verify(
    repo: Path,
    mode: str = "pre-push",
    artifact_path: Path | None = None,
    markdown_path: Path | None = None,
) -> tuple[bool, dict[str, Any], Path, Path]:
    repo = repo.expanduser().resolve()
    cfg = _load_verify_config(repo)
    zone = str(cfg["zone"])
    commands_cfg: dict[str, list[str]] = cfg.get("commands") or {}
    dune_cfg = cfg.get("dune_lint") or {}
    dune_enabled = bool(dune_cfg.get("enabled", True))
    allow_lint_only = bool(cfg.get("allow_lint_only", False))

    steps: list[dict[str, Any]] = []
    ran_command_step = False

    if mode in ("pre-push", "ci"):
        if dune_enabled:
            t0 = time.monotonic()
            dl = _load_module("dune_lint", DUNE_LINT_PATH)
            findings = dl.lint_repo(repo)
            dur = round(time.monotonic() - t0, 2)
            out = (
                "\n".join(f.format() for f in findings[:25])
                if findings
                else "dune_lint: 0 violations."
            )
            steps.append(
                {
                    "stage": "dune_lint",
                    "command": "paf lint-code",
                    "exit_code": 1 if findings else 0,
                    "passed": len(findings) == 0,
                    "duration_sec": dur,
                    "output_tail": out,
                }
            )
        stage_order = ("lint", "typecheck", "unit_test", "boot_smoke", "replay")
        for st in stage_order:
            for cmd in commands_cfg.get(st) or []:
                ran_command_step = True
                step = _run_shell_step(repo, st, cmd)
                steps.append(step)
                if not step["passed"]:
                    break
        if not ran_command_step and not allow_lint_only:
            raise RuntimeError(
                f"Zero behavioral/command verification checks configured in mode '{mode}' for {repo} "
                "(static `dune_lint` alone is insufficient). Configure at least one command in "
                "`commands` (`unit_test`, `typecheck`, `lint`, or `boot_smoke`), or set "
                "`allow_lint_only: true` explicitly."
            )
    elif mode == "post-merge":
        post_cmds = commands_cfg.get("post_merge_check") or []
        if post_cmds:
            for cmd in post_cmds:
                step = _run_shell_step(repo, "post_merge_check", cmd)
                steps.append(step)
                if not step["passed"]:
                    break
        else:
            for fallback_stage in ("unit_test", "boot_smoke"):
                for cmd in commands_cfg.get(fallback_stage) or []:
                    step = _run_shell_step(repo, f"post_merge:{fallback_stage}", cmd)
                    steps.append(step)
                    if not step["passed"]:
                        break
    else:
        raise ValueError(f"Unsupported verify mode: {mode}")

    if not steps:
        raise RuntimeError(
            f"Zero verification checks executed in mode '{mode}' for {repo}. "
            "A gate that matches zero checks must fail loud rather than pass silently."
        )

    overall = all(s["passed"] for s in steps)
    head_sha = _git_head_sha(repo)
    short_sha = head_sha[:12]
    report = {
        "schema_version": 1,
        "repo": str(repo),
        "zone": zone,
        "mode": mode,
        "branch": _git_branch(repo),
        "head_sha": head_sha,
        "timestamp_utc": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "overall_passed": overall,
        "steps": steps,
    }

    git_common = _git_common_dir(repo)
    git_common.mkdir(parents=True, exist_ok=True)
    out_json = artifact_path or (git_common / f"paf-verify-{short_sha}-{mode}.json")
    out_md = markdown_path or (git_common / f"paf-verify-{short_sha}-{mode}.md")

    review_path = git_common / "paf-reviews" / f"{head_sha}.json"
    review = (
        json.loads(review_path.read_text(encoding="utf-8"))
        if review_path.is_file()
        else None
    )

    out_json.write_text(json.dumps(report, indent=2), encoding="utf-8")
    out_md.write_text(_render_verify_markdown(report, review=review), encoding="utf-8")
    return overall, report, out_json, out_md


def cmd_score(args: argparse.Namespace) -> int:
    ms = _load_module("memory_scoring", MEMORY_SCORING_PATH)
    argv = ["--dir", str(args.dir.expanduser().resolve())]
    if args.stats:
        argv.append("--stats")
    return int(ms.main(argv))


def cmd_lint_code(args: argparse.Namespace) -> int:
    dl = _load_module("dune_lint", DUNE_LINT_PATH)
    argv = ["--repo", str(args.repo.expanduser().resolve())]
    if args.changed_only:
        argv.append("--changed-only")
    if args.json:
        argv.append("--json")
    return int(dl.main(argv))


def cmd_verify(args: argparse.Namespace) -> int:
    try:
        passed, report, out_json, out_md = execute_verify(
            args.repo,
            mode=args.mode,
            artifact_path=args.artifact,
            markdown_path=args.markdown,
        )
    except Exception as exc:
        print(f"paf verify ERROR: {exc}", file=sys.stderr)
        return 1

    for step in report["steps"]:
        flag = "PASS" if step["passed"] else "FAIL"
        print(f"[{flag}] {step['stage']}: {step['command']} ({step['duration_sec']:.2f}s)")
        if not step["passed"] and step["output_tail"]:
            print(step["output_tail"])
    print(f"Artifact JSON: {out_json}")
    print(f"Artifact MD:   {out_md}")
    return 0 if passed else 2


def cmd_record_review(args: argparse.Namespace) -> int:
    repo = args.repo.expanduser().resolve()
    head_sha = _git_head_sha(repo)
    if head_sha == "uncommitted":
        print("Cannot record review on uncommitted repo without HEAD.", file=sys.stderr)
        return 1
    reviews_dir = _git_common_dir(repo) / "paf-reviews"
    reviews_dir.mkdir(parents=True, exist_ok=True)
    findings = []
    if args.findings_json:
        findings = json.loads(args.findings_json)
    receipt = {
        "schema_version": 1,
        "head_sha": head_sha,
        "verdict": args.verdict,
        "reviewer": args.reviewer,
        "author_independent": True,
        "summary": args.summary,
        "findings": findings,
        "recorded_at_utc": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    }
    out_file = reviews_dir / f"{head_sha}.json"
    out_file.write_text(json.dumps(receipt, indent=2), encoding="utf-8")
    print(f"Recorded Blind Review ({args.verdict}) for {head_sha[:12]} -> {out_file}")
    return 0


def _wait_for_pr_checks(
    repo: Path,
    pr_number: int,
    expected_head_sha: str,
    max_wait_sec: int,
) -> tuple[bool, str]:
    has_workflows = (repo / ".github" / "workflows").is_dir() and any(
        (repo / ".github" / "workflows").glob("*.y*ml")
    )
    deadline = time.monotonic() + max_wait_sec
    saw_checks = False

    while time.monotonic() < deadline:
        # Ensure GitHub's PR headRefOid matches expected_head_sha before evaluating checks
        head_proc = subprocess.run(
            ["gh", "pr", "view", str(pr_number), "--json", "headRefOid"],
            cwd=repo,
            text=True,
            capture_output=True,
            check=False,
        )
        if head_proc.returncode == 0 and head_proc.stdout.strip().startswith("{"):
            pr_head = json.loads(head_proc.stdout).get("headRefOid")
            if pr_head and pr_head != expected_head_sha:
                time.sleep(3)
                continue

        proc = subprocess.run(
            ["gh", "pr", "checks", str(pr_number), "--json", "name,state,bucket,link"],
            cwd=repo,
            text=True,
            capture_output=True,
            check=False,
        )
        raw = (proc.stdout or "").strip()
        checks: list[dict[str, Any]] = []
        if raw.startswith("["):
            try:
                checks = json.loads(raw)
            except json.JSONDecodeError:
                checks = []

        if not checks:
            if not has_workflows:
                return True, "No GitHub Actions workflows configured; local verification passed."
            time.sleep(5)
            if not saw_checks and (deadline - time.monotonic()) < (max_wait_sec - 15):
                run_proc = subprocess.run(
                    [
                        "gh",
                        "run",
                        "list",
                        "--commit",
                        expected_head_sha,
                        "--limit",
                        "10",
                        "--json",
                        "status,conclusion,headSha,databaseId,name",
                    ],
                    cwd=repo,
                    text=True,
                    capture_output=True,
                    check=False,
                )
                if run_proc.returncode == 0 and run_proc.stdout.strip().startswith("["):
                    runs = [
                        r
                        for r in json.loads(run_proc.stdout)
                        if r.get("headSha") == expected_head_sha
                    ]
                    if runs and all(r.get("status") == "completed" for r in runs):
                        bad = [
                            r
                            for r in runs
                            if r.get("conclusion") not in ("success", "skipped", "neutral")
                        ]
                        if not bad:
                            ids = ", ".join(str(r.get("databaseId")) for r in runs)
                            return True, f"All workflow runs ({ids}) succeeded for {expected_head_sha[:12]}."
                        desc = ", ".join(
                            f"{r.get('name')}:{r.get('conclusion')}" for r in bad
                        )
                        return False, f"Workflow runs failed for {expected_head_sha[:12]}: {desc}"
            continue

        saw_checks = True
        buckets = [str(c.get("bucket", "")).lower() for c in checks]
        if any(b in ("fail", "cancel") for b in buckets):
            failed = [
                f"{c.get('name')}:{c.get('state')}"
                for c in checks
                if str(c.get("bucket", "")).lower() in ("fail", "cancel")
            ]
            return False, "CI checks failed: " + ", ".join(failed)
        if all(b in ("pass", "skipping") for b in buckets):
            names = ", ".join(str(c.get("name")) for c in checks)
            return True, f"All CI checks green ({names})."
        time.sleep(6)

    return False, f"Timed out after {max_wait_sec}s waiting for PR #{pr_number} checks."


def _capture_failed_ci_logs(repo: Path, head_sha: str) -> Path | None:
    proc = subprocess.run(
        ["gh", "run", "list", "--commit", head_sha, "--limit", "5", "--json", "databaseId,conclusion"],
        cwd=repo,
        text=True,
        capture_output=True,
        check=False,
    )
    if proc.returncode != 0 or not proc.stdout.strip().startswith("["):
        return None
    runs = json.loads(proc.stdout)
    failed_runs = [r for r in runs if r.get("conclusion") not in (None, "success", "skipped")]
    if not failed_runs:
        return None
    run_id = str(failed_runs[0]["databaseId"])
    log_proc = subprocess.run(
        ["gh", "run", "view", run_id, "--log-failed"],
        cwd=repo,
        text=True,
        capture_output=True,
        check=False,
    )
    out_path = _git_common_dir(repo) / f"paf-ci-failure-{head_sha[:12]}.log"
    out_path.write_text((log_proc.stdout or "") + "\n" + (log_proc.stderr or ""), encoding="utf-8")
    return out_path


def _auto_revert_merge(repo: Path, base_branch: str, bad_merge_sha: str) -> tuple[bool, str]:
    short_bad = bad_merge_sha[:10]
    rev_branch = f"revert/auto-{short_bad}"
    wt_rev = Path(tempfile.mkdtemp(prefix=f"paf-wt-revert-{short_bad}-"))

    _git(repo, "fetch", "origin", base_branch, check=False)

    add_wt = _git(
        repo,
        "worktree",
        "add",
        "-B",
        rev_branch,
        str(wt_rev),
        f"origin/{base_branch}",
        check=False,
    )
    if add_wt.returncode != 0:
        shutil.rmtree(wt_rev, ignore_errors=True)
        return False, f"Failed creating isolated revert worktree: {add_wt.stderr}"

    try:
        rev = _git(wt_rev, "revert", "--no-edit", bad_merge_sha, check=False)
        if rev.returncode != 0:
            _git(wt_rev, "revert", "--abort", check=False)
            rev_m1 = _git(wt_rev, "revert", "--no-edit", "-m", "1", bad_merge_sha, check=False)
            if rev_m1.returncode != 0:
                _git(wt_rev, "revert", "--abort", check=False)
                return False, f"Automatic git revert failed: {rev.stderr} / {rev_m1.stderr}"

        rev_sha = _git_head_sha(wt_rev)
        push_env = _clean_git_env()
        push_env["PAF_PRE_PUSH_VERIFIED"] = rev_sha
        push_res = subprocess.run(
            [GIT_BIN, "push", "-u", "origin", rev_branch],
            cwd=wt_rev,
            env=push_env,
            text=True,
            capture_output=True,
            check=False,
        )
        if push_res.returncode != 0:
            return False, f"Failed pushing emergency revert branch: {push_res.stderr}"

        pr_create = subprocess.run(
            [
                "gh",
                "pr",
                "create",
                "--base",
                base_branch,
                "--head",
                rev_branch,
                "--title",
                f"[revert] Auto-revert {short_bad} after post-merge verification failure",
                "--body",
                f"Automated post-merge verification failed on `{bad_merge_sha}`. Reverting immediately to restore `{base_branch}` health.",
            ],
            cwd=wt_rev,
            text=True,
            capture_output=True,
            check=False,
        )
        if pr_create.returncode != 0:
            return False, f"Failed opening emergency revert PR: {pr_create.stderr}"

        pr_url = pr_create.stdout.strip().splitlines()[-1]
        pr_view = subprocess.run(
            ["gh", "pr", "view", rev_branch, "--json", "number"],
            cwd=wt_rev,
            text=True,
            capture_output=True,
            check=True,
        )
        rev_pr_num = int(json.loads(pr_view.stdout)["number"])
        rev_ci_ok, rev_ci_msg = _wait_for_pr_checks(
            wt_rev, rev_pr_num, rev_sha, max_wait_sec=300
        )
        if not rev_ci_ok:
            return (
                False,
                f"Revert PR #{rev_pr_num} ({pr_url}) failed CI checks: {rev_ci_msg}",
            )

        merge_res = subprocess.run(
            [
                "gh",
                "pr",
                "merge",
                str(rev_pr_num),
                "--squash",
                "--match-head-commit",
                rev_sha,
            ],
            cwd=wt_rev,
            text=True,
            capture_output=True,
            check=False,
        )
        if merge_res.returncode != 0:
            return (
                False,
                f"Revert PR #{rev_pr_num} created ({pr_url}) but merge failed: {merge_res.stderr}",
            )
        _git(wt_rev, "push", "origin", "--delete", rev_branch, check=False)
        return True, f"Auto-reverted {short_bad} via {pr_url}"
    finally:
        _git(repo, "worktree", "remove", "--force", str(wt_rev), check=False)
        shutil.rmtree(wt_rev, ignore_errors=True)
        _git(repo, "branch", "-D", rev_branch, check=False)


CONSENSUS_RE = re.compile(r"<!--\s*paf-consensus:\s*(\{.*?\})\s*-->", re.DOTALL)
HEX_SHA_RE = re.compile(r"^[0-9a-f]{7,40}$")


FAMILY_ALIASES: dict[str, str] = {
    "claude": "claude",
    "anthropic": "claude",
    "opus": "claude",
    "sonnet": "claude",
    "haiku": "claude",
    "fable": "claude",
    "claude-code": "claude",
    "claude-opus": "claude",
    "claude-sonnet": "claude",
    "claude-haiku": "claude",
    "gemini": "gemini",
    "google": "gemini",
    "antigravity": "gemini",
    "gemini-pro": "gemini",
    "gemini-flash": "gemini",
    "openai": "openai",
    "gpt": "openai",
    "codex": "openai",
    "o1": "openai",
    "o3": "openai",
    "o4": "openai",
    "o4-mini": "openai",
    "gpt-4": "openai",
    "gpt-4o": "openai",
    "gpt-5": "openai",
}


def _normalize_family(raw: Any) -> str:
    val = re.sub(r"[\s_]+", "-", str(raw or "").strip().lower())
    return FAMILY_ALIASES.get(val, "")


def _sha_matches(candidate: Any, expected_full: str) -> bool:
    cand = str(candidate or "").strip().lower()
    exp = expected_full.strip().lower()
    if not (HEX_SHA_RE.match(cand) and HEX_SHA_RE.match(exp)):
        return False
    return exp.startswith(cand) or cand.startswith(exp)


def _resolve_max_rounds(cli_val: int | None, consensus_cfg: dict[str, Any]) -> int:
    if cli_val is not None:
        return int(cli_val)
    if consensus_cfg.get("max_rounds") is not None:
        return int(consensus_cfg["max_rounds"])
    return 3


def _extract_consensus_markers(pr_data: dict[str, Any]) -> list[dict[str, Any]]:
    texts: list[str] = []
    if pr_data.get("body"):
        texts.append(str(pr_data["body"]))
    for comment in pr_data.get("comments") or []:
        if isinstance(comment, dict) and comment.get("body"):
            texts.append(str(comment["body"]))
    markers: list[dict[str, Any]] = []
    for text in texts:
        for match in CONSENSUS_RE.finditer(text):
            try:
                parsed = json.loads(match.group(1))
                if isinstance(parsed, dict):
                    markers.append(parsed)
            except json.JSONDecodeError:
                continue
    return markers


def _extract_author_metadata(
    markers: list[dict[str, Any]],
    *,
    hmac_secret: str | None = None,
    require_hmac: bool = False,
    expected_base: str = "",
    expected_pr_num: int = 0,
) -> tuple[str, list[str], str, set[str], bool, str]:
    pw = _watcher_mod()
    seen: list[str] = []
    author_host = ""
    verified_author_sessions: set[str] = set()
    bad_author_sig = False
    mismatch_detail = ""
    local_kid = pw.compute_key_id(hmac_secret) if hmac_secret else ""

    for m in markers:
        role = str(m.get("role") or "").strip().lower()
        verdict = str(m.get("verdict") or "").strip().lower()
        if role != "author" and verdict != "open":
            continue

        has_sig = bool(str(m.get("sig") or "").strip())
        m_kid = str(m.get("key_id") or "").strip()
        if has_sig and hmac_secret and not pw.verify_consensus_hmac(hmac_secret, m):
            bad_author_sig = True
            if m_kid and local_kid and m_kid != local_kid:
                mismatch_detail = f"key_id mismatch (marker={m_kid}, local={local_kid}); sync ~/.config/paf/consensus.key across machines"
            continue
        if require_hmac:
            if not hmac_secret or not has_sig or not pw.verify_consensus_hmac(hmac_secret, m):
                bad_author_sig = True
                if m_kid and local_kid and m_kid != local_kid:
                    mismatch_detail = f"key_id mismatch (marker={m_kid}, local={local_kid}); sync ~/.config/paf/consensus.key across machines"
                continue

        m_base = str(m.get("base_branch") or "").strip()
        if m_base and expected_base and m_base != expected_base:
            bad_author_sig = True
            continue
        try:
            m_pr_num = int(m["pr_number"]) if m.get("pr_number") is not None else 0
        except (TypeError, ValueError):
            m_pr_num = 0
        if m_pr_num > 0 and expected_pr_num > 0 and m_pr_num != expected_pr_num:
            bad_author_sig = True
            continue

        # Only harvest session_ids AFTER signature/context verification so an unsigned comment cannot DoS a reviewer
        raw_sess = str(m.get("session_id") or "").strip()
        if raw_sess:
            verified_author_sessions.add(raw_sess)

        fam = _normalize_family(m.get("model_family") or m.get("author"))
        if fam and fam not in seen:
            seen.append(fam)
        host_cand = str(m.get("host") or "").strip().lower()
        if host_cand and not author_host:
            author_host = host_cand

    inferred = seen[0] if len(seen) == 1 else ""
    return inferred, seen, author_host, verified_author_sessions, bad_author_sig, mismatch_detail


def _infer_author_family_from_markers(markers: list[dict[str, Any]]) -> tuple[str, list[str]]:
    inferred, seen, _host, _sessions, _bad, _mm = _extract_author_metadata(markers)
    return inferred, seen


def evaluate_pr_consensus(
    pr_data: dict[str, Any],
    *,
    author_family_override: str | None = None,
    max_rounds: int = 3,
    hmac_secret: str | None = None,
    require_hmac: bool = False,
    allow_same_family_fallback: bool = False,
) -> dict[str, Any]:
    pw = _watcher_mod()
    head_sha = str(pr_data.get("headRefOid") or "").strip()
    if not HEX_SHA_RE.match(head_sha.lower()):
        return {
            "status": "pending_review",
            "reason": "PR headRefOid is missing or invalid.",
            "head_sha": head_sha,
            "author_family": None,
            "author_host": "",
            "author_session_ids": [],
            "max_round": 0,
        }

    if require_hmac and not hmac_secret:
        return {
            "status": "pending_review",
            "reason": (
                f"Consensus HMAC key is required (require_hmac=true) on {head_sha}, "
                "but no consensus.key was found. Run `paf init-consensus-key`."
            ),
            "head_sha": head_sha,
            "author_family": None,
            "author_host": "",
            "author_session_ids": [],
            "max_round": 0,
        }

    expected_base = str(pr_data.get("baseRefName") or "").strip()
    try:
        expected_pr_num = int(pr_data["number"]) if pr_data.get("number") is not None else 0
    except (TypeError, ValueError):
        expected_pr_num = 0
    local_kid = pw.compute_key_id(hmac_secret) if hmac_secret else ""

    markers = _extract_consensus_markers(pr_data)
    inferred_af, seen_authors, author_host, author_session_ids, bad_author_sig, key_mismatch = (
        _extract_author_metadata(
            markers,
            hmac_secret=hmac_secret,
            require_hmac=require_hmac,
            expected_base=expected_base,
            expected_pr_num=expected_pr_num,
        )
    )
    author_family = _normalize_family(author_family_override)
    if not author_family:
        if len(seen_authors) > 1:
            return {
                "status": "pending_review",
                "reason": (
                    f"Conflicting author model_family markers ({', '.join(seen_authors)}) on {head_sha}; "
                    "pass --author-family explicitly."
                ),
                "head_sha": head_sha,
                "author_family": None,
                "author_host": author_host,
                "author_session_ids": sorted(author_session_ids),
                "max_round": 0,
            }
        author_family = inferred_af

    if not author_family:
        extra_hint = ""
        if key_mismatch:
            extra_hint = f" ({key_mismatch})"
        elif bad_author_sig:
            extra_hint = " (unsigned, replayed, or tampered author marker ignored)"
        return {
            "status": "pending_review",
            "reason": (
                f"Cannot verify heterogeneity on {head_sha}: author model_family is unknown"
                f"{extra_hint} (no recognized author marker on PR and no --author-family provided)."
            ),
            "head_sha": head_sha,
            "author_family": None,
            "author_host": author_host,
            "author_session_ids": sorted(author_session_ids),
            "max_round": 0,
        }

    max_round_seen = 0
    needs_human = False
    same_family_rejected = False
    same_session_rejected = False
    hmac_rejected = False
    replay_rejected = False
    unknown_reviewer_rejected = False
    latest_by_family: dict[str, dict[str, Any]] = {}
    unlabeled_objections: list[dict[str, Any]] = []

    for m in markers:
        role = str(m.get("role") or "").strip().lower()
        verdict = str(m.get("verdict") or "").strip().lower()
        flag_nh = bool(m.get("needs_human_decision"))
        if role == "author" or verdict == "open":
            continue
        if verdict not in ("approve", "request_changes") and not flag_nh:
            continue
        if not _sha_matches(m.get("head_sha"), head_sha):
            continue
        try:
            rnd = int(m["round"]) if m.get("round") is not None else 1
            blocking = int(m["blocking_count"]) if m.get("blocking_count") is not None else 0
        except (TypeError, ValueError):
            continue
        if rnd < 1 or blocking < 0:
            continue
        rev_fam = _normalize_family(m.get("model_family") or m.get("reviewer"))
        rev_sess = str(m.get("session_id") or "").strip()
        is_objection = (verdict != "approve") or (blocking > 0) or flag_nh
        valid_fallback = False

        if not is_objection:
            has_sig = bool(str(m.get("sig") or "").strip())
            m_kid = str(m.get("key_id") or "").strip()
            if has_sig and hmac_secret and not pw.verify_consensus_hmac(hmac_secret, m):
                hmac_rejected = True
                if m_kid and local_kid and m_kid != local_kid:
                    key_mismatch = f"key_id mismatch (marker={m_kid}, local={local_kid}); sync ~/.config/paf/consensus.key across machines"
                continue
            if require_hmac:
                raw_m_sha = str(m.get("head_sha") or "").strip().lower()
                if (
                    not hmac_secret
                    or not has_sig
                    or raw_m_sha != head_sha.lower()
                    or not pw.verify_consensus_hmac(hmac_secret, m)
                ):
                    hmac_rejected = True
                    if m_kid and local_kid and m_kid != local_kid:
                        key_mismatch = f"key_id mismatch (marker={m_kid}, local={local_kid}); sync ~/.config/paf/consensus.key across machines"
                    continue
            m_base = str(m.get("base_branch") or "").strip()
            try:
                m_pr_num = int(m["pr_number"]) if m.get("pr_number") is not None else 0
            except (TypeError, ValueError):
                m_pr_num = 0
            if m_base and expected_base and m_base != expected_base:
                replay_rejected = True
                continue
            if m_pr_num > 0 and expected_pr_num > 0 and m_pr_num != expected_pr_num:
                replay_rejected = True
                continue
            if require_hmac and (
                (expected_base and m_base != expected_base)
                or (expected_pr_num > 0 and m_pr_num != expected_pr_num)
            ):
                replay_rejected = True
                continue
            if not rev_fam:
                unknown_reviewer_rejected = True
                continue
            if rev_sess and rev_sess in author_session_ids:
                same_session_rejected = True
                continue
            if rev_fam == author_family:
                if (
                    allow_same_family_fallback
                    and bool(m.get("fallback_same_family"))
                    and bool(author_session_ids)
                    and bool(rev_sess)
                    and rev_sess not in author_session_ids
                ):
                    valid_fallback = True
                elif (
                    author_family in latest_by_family
                    and bool(author_session_ids)
                    and bool(rev_sess)
                    and rev_sess not in author_session_ids
                ):
                    same_family_rejected = True
                else:
                    same_family_rejected = True
                    continue

        if rnd > max_round_seen:
            max_round_seen = rnd
        if flag_nh:
            needs_human = True
        entry = {
            **m,
            "normalized_family": rev_fam or "unlabeled",
            "verdict": "request_changes" if is_objection else "approve",
            "round": rnd,
            "blocking_count": blocking,
            "is_valid_fallback": valid_fallback,
        }
        if rev_fam:
            latest_by_family[rev_fam] = entry
        else:
            unlabeled_objections.append(entry)

    if needs_human:
        return {
            "status": "paused_human_tiebreak",
            "reason": f"Reviewer flagged needs_human_decision=true on {head_sha}.",
            "head_sha": head_sha,
            "author_family": author_family,
            "author_host": author_host,
            "author_session_ids": sorted(author_session_ids),
            "max_round": max_round_seen,
        }

    open_objections = [
        e for e in latest_by_family.values() if e["verdict"] != "approve" or e["blocking_count"] > 0
    ] + unlabeled_objections
    if open_objections:
        if max_round_seen > max_rounds:
            return {
                "status": "paused_human_tiebreak",
                "reason": f"Consensus exceeded max_rounds={max_rounds} (saw round {max_round_seen}) without approval on {head_sha}.",
                "head_sha": head_sha,
                "author_family": author_family,
                "author_host": author_host,
                "author_session_ids": sorted(author_session_ids),
                "max_round": max_round_seen,
            }
        last_obj = open_objections[-1]
        return {
            "status": "changes_requested",
            "reason": f"Open objection on {head_sha} by '{last_obj['normalized_family']}' requested changes.",
            "head_sha": head_sha,
            "author_family": author_family,
            "author_host": author_host,
            "author_session_ids": sorted(author_session_ids),
            "reviewer_family": last_obj["normalized_family"],
            "max_round": max_round_seen,
        }

    hetero_approvals = [
        e
        for fam, e in latest_by_family.items()
        if fam != author_family and e["verdict"] == "approve" and e["blocking_count"] == 0
    ]
    if hetero_approvals:
        latest = hetero_approvals[-1]
        return {
            "status": "approved",
            "reason": f"Heterogeneous consensus approved by '{latest['normalized_family']}' on {head_sha}.",
            "head_sha": head_sha,
            "author_family": author_family,
            "author_host": author_host,
            "author_session_ids": sorted(author_session_ids),
            "reviewer_family": latest["normalized_family"],
            "fallback_used": False,
            "round": latest["round"],
            "max_round": max_round_seen,
        }

    fb_entry = latest_by_family.get(author_family)
    if (
        allow_same_family_fallback
        and fb_entry is not None
        and fb_entry["verdict"] == "approve"
        and fb_entry["blocking_count"] == 0
        and fb_entry.get("is_valid_fallback") is True
    ):
        return {
            "status": "approved",
            "reason": (
                f"Same-family fresh-session fallback approved by '{author_family}' "
                f"(session {fb_entry.get('session_id')}) on {head_sha}."
            ),
            "head_sha": head_sha,
            "author_family": author_family,
            "author_host": author_host,
            "author_session_ids": sorted(author_session_ids),
            "reviewer_family": author_family,
            "fallback_used": True,
            "round": fb_entry["round"],
            "max_round": max_round_seen,
        }

    if replay_rejected:
        reason = (
            f"Rejected replayed consensus marker (PR number or base_branch mismatch) on --head-sha {head_sha}."
        )
    elif hmac_rejected:
        detail = f" ({key_mismatch})" if key_mismatch else ""
        reason = (
            f"Rejected unsigned or tampered consensus signature{detail}; awaiting valid HMAC-signed approval on --head-sha {head_sha}."
        )
    elif same_session_rejected:
        reason = (
            f"Rejected self-review from authoring session; awaiting independent session/family on --head-sha {head_sha}."
        )
    elif same_family_rejected:
        reason = (
            f"Rejected same-family review ('{author_family}'); awaiting heterogeneous reviewer on --head-sha {head_sha}."
        )
    elif unknown_reviewer_rejected:
        reason = (
            f"Rejected review marker with missing or unrecognized model_family; awaiting heterogeneous reviewer on --head-sha {head_sha}."
        )
    else:
        reason = f"No SHA-pinned heterogeneous consensus marker found yet for --head-sha {head_sha}."
    return {
        "status": "pending_review",
        "reason": reason,
        "head_sha": head_sha,
        "author_family": author_family,
        "author_host": author_host,
        "author_session_ids": sorted(author_session_ids),
        "max_round": max_round_seen,
    }


def _load_pr_data(repo: Path, pr_ref: str | None, pr_fixture: Path | None = None) -> dict[str, Any]:
    if pr_fixture is not None:
        return json.loads(pr_fixture.expanduser().resolve().read_text(encoding="utf-8"))
    target = pr_ref or _git_branch(repo)
    proc = subprocess.run(
        [
            "gh",
            "pr",
            "view",
            str(target),
            "--json",
            "number,url,state,headRefName,baseRefName,headRefOid,body,comments,files,changedFiles,reviewDecision",
        ],
        cwd=repo,
        text=True,
        capture_output=True,
        check=False,
    )
    if proc.returncode != 0 or not proc.stdout.strip().startswith("{"):
        raise RuntimeError(f"Unable to load PR '{target}': {proc.stderr.strip()}")
    return json.loads(proc.stdout)


def _merge_and_verify_pr(
    repo: Path,
    *,
    pr_number: int,
    pr_url: str,
    head_sha: str,
    branch: str,
    base_branch: str,
    max_wait_ci: int,
    no_auto_revert: bool,
) -> int:
    print(f"Waiting for CI checks on PR #{pr_number} ({pr_url}) ...")
    ci_ok, ci_msg = _wait_for_pr_checks(repo, pr_number, head_sha, max_wait_sec=max_wait_ci)
    print(ci_msg)
    if not ci_ok:
        log_file = _capture_failed_ci_logs(repo, head_sha)
        if log_file:
            print(f"CI_FAILED_NEEDS_FIX: failure logs captured at {log_file}", file=sys.stderr)
        return 3

    # Omit `--delete-branch` here so linked git worktrees never fail trying to checkout base_branch locally
    merge_proc = subprocess.run(
        [
            "gh",
            "pr",
            "merge",
            str(pr_number),
            "--squash",
            "--match-head-commit",
            head_sha,
        ],
        cwd=repo,
        text=True,
        capture_output=True,
        check=False,
    )
    if merge_proc.returncode != 0:
        print(
            f"paf atomic merge failed (head {head_sha[:12]}):\n{merge_proc.stderr}",
            file=sys.stderr,
        )
        return 1

    if branch and branch not in (base_branch, "main", "master"):
        _git(repo, "push", "origin", "--delete", branch, check=False)

    _git(repo, "fetch", "origin", base_branch, check=True)
    merged_sha = ""
    for _ in range(4):
        mc_proc = subprocess.run(
            ["gh", "pr", "view", str(pr_number), "--json", "mergeCommit"],
            cwd=repo,
            text=True,
            capture_output=True,
            check=False,
        )
        if mc_proc.returncode == 0 and mc_proc.stdout.strip().startswith("{"):
            mc = (json.loads(mc_proc.stdout) or {}).get("mergeCommit") or {}
            if mc.get("oid"):
                merged_sha = str(mc["oid"])
                break
        time.sleep(1.5)
    if not merged_sha:
        merged_sha = _git(repo, "rev-parse", f"origin/{base_branch}", check=True).stdout.strip()
    else:
        _git(repo, "fetch", "origin", base_branch, check=True)

    is_linked_wt = (repo / ".git").is_file() or _is_branch_checked_out_elsewhere(repo, base_branch)
    cleanup_wt: Path | None = None
    if not is_linked_wt:
        chk = _git(repo, "checkout", base_branch, check=False)
        if chk.returncode == 0:
            _git(repo, "pull", "--ff-only", "origin", base_branch, check=True)
            if branch and branch not in (base_branch, "main", "master"):
                _git(repo, "branch", "-D", branch, check=False)
            post_repo = repo
        else:
            wt_tmp = Path(tempfile.mkdtemp(prefix=f"paf-wt-post-merge-{merged_sha[:8]}-"))
            _git(repo, "worktree", "add", "--detach", str(wt_tmp), merged_sha, check=True)
            post_repo = wt_tmp
            cleanup_wt = wt_tmp
    else:
        wt_tmp = Path(tempfile.mkdtemp(prefix=f"paf-wt-post-merge-{merged_sha[:8]}-"))
        _git(repo, "worktree", "add", "--detach", str(wt_tmp), merged_sha, check=True)
        post_repo = wt_tmp
        cleanup_wt = wt_tmp

    post_json: Path | None = None
    try:
        post_ok, _post_report, post_json, _post_md = execute_verify(post_repo, mode="post-merge")
    except Exception as exc:
        print(f"POST_MERGE_VERIFICATION_ERROR: {exc}", file=sys.stderr)
        post_ok = False
    finally:
        if cleanup_wt is not None:
            _git(repo, "worktree", "remove", "--force", str(cleanup_wt), check=False)
            shutil.rmtree(cleanup_wt, ignore_errors=True)

    if post_ok:
        print(f"SHIPPED_AND_VERIFIED: {pr_url} -> {base_branch}@{merged_sha[:12]}")
        return 0

    print(
        f"POST_MERGE_VERIFICATION_FAILED on {base_branch}@{merged_sha[:12]}! Artifact: {post_json}",
        file=sys.stderr,
    )
    if not no_auto_revert:
        rev_ok, rev_msg = _auto_revert_merge(repo, base_branch, merged_sha)
        print(rev_msg, file=sys.stderr)
        return 4 if rev_ok else 5
    return 4


def cmd_check_consensus(args: argparse.Namespace) -> int:
    repo = args.repo.expanduser().resolve()
    try:
        cfg = _load_verify_config(repo)
    except Exception as exc:
        print(f"paf check-consensus ERROR: {exc}", file=sys.stderr)
        return 1
    consensus_cfg = cfg.get("consensus") or {}
    max_rounds = _resolve_max_rounds(args.max_rounds, consensus_cfg)
    pw = _watcher_mod()
    try:
        hmac_secret = pw.load_consensus_secret(getattr(args, "key_file", None))
    except pw.ConsensusKeyError as exc:
        print(f"paf check-consensus ERROR: {exc}", file=sys.stderr)
        return 1
    require_hmac = bool(getattr(args, "require_hmac", False) or consensus_cfg.get("require_hmac", False))
    allow_fb = bool(
        getattr(args, "allow_same_family_fallback", False)
        or consensus_cfg.get("allow_same_family_fallback", False)
    )
    try:
        pr_data = _load_pr_data(repo, args.pr, args.pr_fixture)
    except Exception as exc:
        print(f"paf check-consensus ERROR: {exc}", file=sys.stderr)
        return 1

    verdict = evaluate_pr_consensus(
        pr_data,
        author_family_override=args.author_family,
        max_rounds=max_rounds,
        hmac_secret=hmac_secret,
        require_hmac=require_hmac,
        allow_same_family_fallback=allow_fb,
    )
    if args.json:
        print(json.dumps(verdict, indent=2))
    else:
        prefix = (
            "PAUSED_FOR_CONSENSUS_TIEBREAK"
            if verdict["status"] == "paused_human_tiebreak"
            else verdict["status"].upper()
        )
        print(f"{prefix}: {verdict['reason']}")

    if verdict["status"] == "approved":
        return 0
    if verdict["status"] == "paused_human_tiebreak":
        return 4
    return 2


def cmd_merge_consensus(args: argparse.Namespace) -> int:
    repo = args.repo.expanduser().resolve()
    try:
        cfg = _load_verify_config(repo)
    except Exception as exc:
        print(f"paf merge-consensus ERROR: {exc}", file=sys.stderr)
        return 1
    zone = str(cfg["zone"])
    default_branch = str(cfg.get("default_branch", "main"))
    staging_branches = _resolve_staging_branches(cfg)
    consensus_cfg = cfg.get("consensus") or {}
    max_rounds = _resolve_max_rounds(args.max_rounds, consensus_cfg)
    pw = _watcher_mod()
    try:
        hmac_secret = pw.load_consensus_secret(getattr(args, "key_file", None))
    except pw.ConsensusKeyError as exc:
        print(f"paf merge-consensus ERROR: {exc}", file=sys.stderr)
        return 1
    require_hmac = bool(getattr(args, "require_hmac", False) or consensus_cfg.get("require_hmac", False))
    allow_fb = bool(
        getattr(args, "allow_same_family_fallback", False)
        or consensus_cfg.get("allow_same_family_fallback", False)
    )

    try:
        pr_data = _load_pr_data(repo, args.pr, args.pr_fixture)
    except Exception as exc:
        print(f"paf merge-consensus ERROR: {exc}", file=sys.stderr)
        return 1

    if str(pr_data.get("state") or "").upper() != "OPEN":
        print(f"paf merge-consensus REFUSED: PR #{pr_data.get('number')} state is {pr_data.get('state')}.", file=sys.stderr)
        return 1

    review_decision = str(pr_data.get("reviewDecision") or "").strip().upper()
    if review_decision in ("REVIEW_REQUIRED", "CHANGES_REQUESTED"):
        print(
            f"paf merge-consensus BLOCKED (human_review_required): GitHub reviewDecision is '{review_decision}' — "
            "model consensus does not replace required human colleague review.",
            file=sys.stderr,
        )
        return 2

    verdict = evaluate_pr_consensus(
        pr_data,
        author_family_override=args.author_family,
        max_rounds=max_rounds,
        hmac_secret=hmac_secret,
        require_hmac=require_hmac,
        allow_same_family_fallback=allow_fb,
    )
    if verdict["status"] == "paused_human_tiebreak":
        print(f"PAUSED_FOR_CONSENSUS_TIEBREAK: {verdict['reason']}", file=sys.stderr)
        return 4
    if verdict["status"] != "approved":
        print(f"paf merge-consensus BLOCKED ({verdict['status']}): {verdict['reason']}", file=sys.stderr)
        return 2

    head_sha = str(pr_data["headRefOid"])
    base_branch = str(pr_data.get("baseRefName") or default_branch)
    branch = str(pr_data.get("headRefName") or "")
    pr_number = int(pr_data["number"])
    pr_url = str(pr_data.get("url") or f"PR#{pr_number}")
    requires_human_merge_approval = zone == "guarded" and base_branch not in staging_branches
    gov_files = _governance_files_touched(repo, pr_data, base_branch)

    if requires_human_merge_approval and not args.approved_main:
        print(f"PAUSED_FOR_MAIN_APPROVAL: {pr_url} (base={base_branch} head={head_sha})")
        print(
            f"Dual-model consensus is complete. Once Leo replies 'approve' (and any stricter workspace rule is met), resume via:\n"
            f"  paf merge-consensus --repo {repo} --pr {pr_number} --approved-main"
        )
        return 0

    if gov_files and not (args.approved_governance or args.approved_main):
        print(
            f"PAUSED_FOR_GOVERNANCE_APPROVAL: {pr_url} (head={head_sha}) modifies governance/permission files: "
            f"{', '.join(gov_files)}"
        )
        print(
            f"Once Leo confirms this rule/permission change, resume via:\n"
            f"  paf merge-consensus --repo {repo} --pr {pr_number} --approved-governance"
        )
        return 0

    if args.dry_run:
        print(f"CONSENSUS_AUTONOMOUS_MERGE_READY: zone={zone} base={base_branch} sha={head_sha}")
        return 0

    return _merge_and_verify_pr(
        repo,
        pr_number=pr_number,
        pr_url=pr_url,
        head_sha=head_sha,
        branch=branch,
        base_branch=base_branch,
        max_wait_ci=args.max_wait_ci,
        no_auto_revert=args.no_auto_revert,
    )


def cmd_post_consensus(args: argparse.Namespace) -> int:
    repo = args.repo.expanduser().resolve()
    family = _normalize_family(args.family)
    if not family:
        print(
            "paf post-consensus REFUSED: unrecognized --family (expected claude, gemini, or openai).",
            file=sys.stderr,
        )
        return 2

    if args.role == "reviewer" and not args.head_sha:
        print(
            "paf post-consensus REFUSED: --head-sha <reviewed_commit_sha> is required when --role reviewer "
            "so a concurrent push cannot be certified unreviewed.",
            file=sys.stderr,
        )
        return 2

    try:
        pr_data = _load_pr_data(repo, args.pr, args.pr_fixture)
    except Exception as exc:
        print(f"paf post-consensus ERROR: {exc}", file=sys.stderr)
        return 1

    live_head = str(pr_data.get("headRefOid") or "").strip()
    if not HEX_SHA_RE.match(live_head.lower()):
        print(f"paf post-consensus ERROR: invalid PR headRefOid '{live_head}'.", file=sys.stderr)
        return 1

    if args.head_sha and not _sha_matches(args.head_sha, live_head):
        print(
            f"paf post-consensus REFUSED: PR #{pr_data.get('number')} moved to {live_head[:12]} "
            f"(expected {args.head_sha[:12]}). Re-read the updated diff before posting.",
            file=sys.stderr,
        )
        return 2

    consensus_cfg: dict[str, Any] = {}
    if (repo / ".agent-verify.json").is_file():
        try:
            consensus_cfg = (_load_verify_config(repo).get("consensus") or {})
        except Exception:
            consensus_cfg = {}
    require_hmac = bool(getattr(args, "require_hmac", False) or consensus_cfg.get("require_hmac", False))

    pw = _watcher_mod()
    try:
        hmac_secret = pw.load_consensus_secret(getattr(args, "key_file", None))
    except pw.ConsensusKeyError as exc:
        print(f"paf post-consensus ERROR: {exc}", file=sys.stderr)
        return 1
    host_id = pw.resolve_host_id(getattr(args, "host", None))
    session_id = _resolve_session_id(getattr(args, "session_id", None))

    if args.role == "reviewer" and session_id:
        existing_markers = _extract_consensus_markers(pr_data)
        _inf_af, _seen_af, _ah, author_sessions, _bad, _mm = _extract_author_metadata(
            existing_markers,
            hmac_secret=hmac_secret,
            require_hmac=require_hmac,
            expected_base=str(pr_data.get("baseRefName") or "").strip(),
            expected_pr_num=int(pr_data["number"]) if pr_data.get("number") is not None else 0,
        )
        if session_id in author_sessions and args.verdict == "approve":
            print(
                f"paf post-consensus REFUSED: authoring session '{session_id}' cannot post an approve review on its own PR.",
                file=sys.stderr,
            )
            return 2

    pr_base = str(pr_data.get("baseRefName") or "").strip()
    pr_num_int = int(pr_data["number"]) if pr_data.get("number") is not None else 0
    marker: dict[str, Any] = {
        "v": 1,
        "role": args.role,
        "model_family": family,
        "verdict": args.verdict,
        "head_sha": live_head.lower(),
        "round": args.round,
        "blocking_count": args.blocking_count,
        "needs_human_decision": bool(args.needs_human_decision),
        "host": host_id,
    }
    if pr_base:
        marker["base_branch"] = pr_base
    if pr_num_int > 0:
        marker["pr_number"] = pr_num_int
    if session_id:
        marker["session_id"] = session_id
    if getattr(args, "fallback_same_family", False):
        marker["fallback_same_family"] = True
    try:
        pw.sign_marker_in_place(
            marker,
            hmac_secret,
            key_file=getattr(args, "key_file", None),
            require_hmac=(require_hmac and args.verdict in ("open", "approve")),
        )
    except pw.ConsensusKeyError as exc:
        print(f"paf post-consensus REFUSED: {exc}", file=sys.stderr)
        return 2

    prose = ""
    if args.body_file is not None:
        prose = args.body_file.expanduser().resolve().read_text(encoding="utf-8").strip()
    elif args.body:
        prose = args.body.strip()
    comment_body = (prose + "\n\n" if prose else "") + f"<!-- paf-consensus: {json.dumps(marker, separators=(',', ':'))} -->"

    if args.pr_fixture is not None:
        print(comment_body)
        return 0

    post_proc = subprocess.run(
        ["gh", "pr", "comment", str(pr_data["number"]), "--body", comment_body],
        cwd=repo,
        text=True,
        capture_output=True,
        check=False,
    )
    if post_proc.returncode != 0:
        print(f"paf post-consensus comment failed:\n{post_proc.stderr}", file=sys.stderr)
        return 1
    print(post_proc.stdout.strip())

    if args.auto_merge and args.verdict == "approve" and not args.needs_human_decision and args.blocking_count == 0:
        merge_ns = argparse.Namespace(
            repo=repo,
            pr=str(pr_data["number"]),
            pr_fixture=None,
            author_family=args.author_family,
            max_rounds=args.max_rounds,
            key_file=getattr(args, "key_file", None),
            require_hmac=getattr(args, "require_hmac", False),
            allow_same_family_fallback=getattr(args, "allow_same_family_fallback", False),
            approved_main=args.approved_main,
            approved_governance=args.approved_governance,
            max_wait_ci=args.max_wait_ci,
            no_auto_revert=args.no_auto_revert,
            dry_run=False,
        )
        return cmd_merge_consensus(merge_ns)
    return 0


def cmd_ship(args: argparse.Namespace) -> int:
    repo = args.repo.expanduser().resolve()
    try:
        cfg = _load_verify_config(repo)
    except Exception as exc:
        print(f"paf ship ERROR: {exc}", file=sys.stderr)
        return 1
    zone = str(cfg["zone"])
    default_branch = str(cfg.get("default_branch", "main"))
    staging_branches = _resolve_staging_branches(cfg)
    base_branch = str(args.base or default_branch)
    require_blind = bool(cfg.get("require_blind_review", True))
    consensus_cfg = cfg.get("consensus") or {}
    max_rounds = _resolve_max_rounds(None, consensus_cfg)
    pw = _watcher_mod()
    try:
        hmac_secret = pw.load_consensus_secret(getattr(args, "key_file", None))
    except pw.ConsensusKeyError as exc:
        print(f"paf ship ERROR: {exc}", file=sys.stderr)
        return 1
    require_hmac = bool(consensus_cfg.get("require_hmac", False))
    allow_fb = bool(consensus_cfg.get("allow_same_family_fallback", False))
    host_id = pw.resolve_host_id(getattr(args, "host", None))
    session_id = _resolve_session_id(getattr(args, "session_id", None))

    branch = _git_branch(repo)
    if branch in (default_branch, "main", "master", "HEAD", "unknown"):
        print(
            f"paf ship REFUSED: current branch is '{branch}'. Always ship from a feature branch.",
            file=sys.stderr,
        )
        return 1

    dirty = _git(repo, "status", "--porcelain", check=True).stdout.strip()
    if dirty:
        print(
            f"paf ship REFUSED: working tree has uncommitted changes:\n{dirty}",
            file=sys.stderr,
        )
        return 1

    # Step 1: Run full local pre-push verification
    try:
        passed, report, _art_json, art_md = execute_verify(repo, mode="pre-push")
    except Exception as exc:
        print(f"paf ship BLOCKED: pre-push verification error: {exc}", file=sys.stderr)
        return 2

    if not passed:
        print("paf ship BLOCKED: local pre-push verification failed.", file=sys.stderr)
        for s in report["steps"]:
            if not s["passed"]:
                print(f"--- FAILED STAGE: {s['stage']} ---\n{s['output_tail']}", file=sys.stderr)
        return 2

    head_sha = report["head_sha"]
    git_common = _git_common_dir(repo)
    review_file = git_common / "paf-reviews" / f"{head_sha}.json"
    review = (
        json.loads(review_file.read_text(encoding="utf-8"))
        if review_file.is_file()
        else None
    )

    requires_human_merge_approval = zone == "guarded" and base_branch not in staging_branches
    author_fam = _normalize_family(args.author_family)

    parsed_pr: dict[str, Any] | None = None
    if args.pr_fixture is not None:
        parsed_pr = json.loads(args.pr_fixture.expanduser().resolve().read_text(encoding="utf-8"))
    else:
        existing_pr = subprocess.run(
            [
                "gh",
                "pr",
                "view",
                branch,
                "--json",
                "number,url,state,baseRefName,headRefOid,body,comments,files,changedFiles,reviewDecision",
            ],
            cwd=repo,
            text=True,
            capture_output=True,
            check=False,
        )
        if existing_pr.returncode == 0 and existing_pr.stdout.strip().startswith("{"):
            parsed_pr = json.loads(existing_pr.stdout)

    open_pr_info: dict[str, Any] | None = None
    has_consensus_markers = False
    cons_verdict: dict[str, Any] | None = None
    remote_pr_head = ""
    existing_author_host = ""
    if parsed_pr is not None and parsed_pr.get("state") == "OPEN":
        open_pr_info = parsed_pr
        pr_markers = _extract_consensus_markers(parsed_pr)
        has_consensus_markers = bool(pr_markers)
        inferred_af, seen_af, inferred_host, _a_sess, _bad_sig, _mm = _extract_author_metadata(
            pr_markers,
            hmac_secret=hmac_secret,
            require_hmac=require_hmac,
            expected_base=str(parsed_pr.get("baseRefName") or base_branch).strip(),
            expected_pr_num=int(parsed_pr["number"]) if parsed_pr.get("number") is not None else 0,
        )
        existing_author_host = inferred_host
        if (
            existing_author_host
            and existing_author_host != host_id
            and not getattr(args, "allow_cross_host", False)
        ):
            print(
                f"paf ship REFUSED (author_host affinity): PR #{parsed_pr.get('number')} is owned by host '{existing_author_host}' "
                f"(current host='{host_id}'). Ship/merge from '{existing_author_host}' or pass --allow-cross-host.",
                file=sys.stderr,
            )
            return 2
        if not author_fam and len(seen_af) == 1:
            author_fam = inferred_af
        remote_pr_head = str(parsed_pr.get("headRefOid") or "")
        if remote_pr_head == head_sha:
            cons_verdict = evaluate_pr_consensus(
                parsed_pr,
                author_family_override=author_fam or None,
                max_rounds=max_rounds,
                hmac_secret=hmac_secret,
                require_hmac=require_hmac,
                allow_same_family_fallback=allow_fb,
            )
        elif remote_pr_head and not (args.allow_update_pr or args.open_for_consensus):
            print(
                f"paf ship REFUSED ('one PR one head'): OPEN PR #{parsed_pr.get('number')} "
                f"already exists on '{branch}' at {remote_pr_head[:12]}, while local HEAD is "
                f"{head_sha[:12]}. Open a fresh branch from '{base_branch}' or pass "
                "--open-for-consensus / --allow-update-pr for multi-round PR consensus.",
                file=sys.stderr,
            )
            return 1

    if args.open_for_consensus:
        if not author_fam:
            print(
                "paf ship BLOCKED: --open-for-consensus requires --author-family (claude, gemini, or openai).",
                file=sys.stderr,
            )
            return 2
        if require_hmac and not hmac_secret and not args.dry_run:
            print(
                "paf ship REFUSED: consensus.require_hmac=true requires a valid consensus.key before opening/updating a PR. "
                "Run `paf init-consensus-key` first.",
                file=sys.stderr,
            )
            return 2
        if args.dry_run:
            print(f"DRY_RUN_OPEN_FOR_CONSENSUS_READY: zone={zone} base={base_branch} author={author_fam} sha={head_sha}")
            return 0

    if open_pr_info is not None:
        rev_dec = str(open_pr_info.get("reviewDecision") or "").strip().upper()
        if rev_dec in ("REVIEW_REQUIRED", "CHANGES_REQUESTED"):
            print(
                f"paf ship BLOCKED (human_review_required): GitHub reviewDecision is '{rev_dec}' — "
                "model consensus does not replace required human colleague review.",
                file=sys.stderr,
            )
            return 2

    # When an open PR carries any consensus marker, PR consensus is the sole gate (a local receipt never overrides it)
    local_review_ok = bool(review and review.get("verdict") == "approve" and review.get("head_sha") == head_sha)
    if not args.open_for_consensus:
        if has_consensus_markers:
            if remote_pr_head != head_sha or cons_verdict is None:
                print(
                    f"paf ship BLOCKED (pending_review): PR #{open_pr_info.get('number') if open_pr_info else '?'} "
                    f"carries consensus markers at {remote_pr_head[:12]}, while local HEAD is {head_sha[:12]}; "
                    "push with --open-for-consensus and obtain a fresh SHA-pinned approve before merging.",
                    file=sys.stderr,
                )
                return 2
            if cons_verdict["status"] == "paused_human_tiebreak":
                print(f"PAUSED_FOR_CONSENSUS_TIEBREAK: {cons_verdict['reason']}", file=sys.stderr)
                return 4
            if cons_verdict["status"] != "approved":
                print(
                    f"paf ship BLOCKED ({cons_verdict['status']}): {cons_verdict['reason']}",
                    file=sys.stderr,
                )
                return 2
        elif require_blind and not local_review_ok:
            print(
                f"paf ship BLOCKED: missing SHA-pinned approval for {head_sha[:12]}.\n"
                "Either open for cross-model PR consensus (`paf ship --open-for-consensus --author-family <claude|gemini>`)\n"
                "or record a blind review receipt (`paf record-review --verdict approve ...`).",
                file=sys.stderr,
            )
            return 2

    gov_files = _governance_files_touched(repo, open_pr_info, base_branch)

    if args.dry_run:
        if requires_human_merge_approval and not args.approved_main:
            print(
                f"PAUSED_FOR_MAIN_APPROVAL (dry-run): zone=guarded base={base_branch} sha={head_sha}"
            )
            return 0
        if gov_files and not (args.approved_governance or args.approved_main):
            print(
                f"PAUSED_FOR_GOVERNANCE_APPROVAL (dry-run): sha={head_sha} files={','.join(gov_files)}"
            )
            return 0
        print(
            f"DRY_RUN_AUTONOMOUS_MERGE_READY: zone={zone} base={base_branch} sha={head_sha}"
        )
        return 0

    # Step 2: Push branch (pre-push hook recognizes PAF_PRE_PUSH_VERIFIED=<head_sha>)
    push_env = _clean_git_env()
    push_env["PAF_PRE_PUSH_VERIFIED"] = head_sha
    push_proc = subprocess.run(
        [GIT_BIN, "push", "-u", "origin", branch],
        cwd=repo,
        env=push_env,
        text=True,
        capture_output=True,
        check=False,
    )
    if push_proc.returncode != 0:
        print(f"paf ship push failed:\n{push_proc.stderr}", file=sys.stderr)
        return 1

    # Step 3: Create or update GitHub PR with Verification Artifact (+ Author Consensus Tag when applicable)
    pr_body_sections = []
    if args.body:
        pr_body_sections.append(args.body.strip())
    pr_body_sections.append(art_md.read_text(encoding="utf-8").strip())
    if author_fam:
        author_marker: dict[str, Any] = {
            "v": 1,
            "role": "author",
            "model_family": author_fam,
            "verdict": "open",
            "head_sha": head_sha.lower(),
            "host": existing_author_host or host_id,
            "base_branch": base_branch,
        }
        if open_pr_info is not None and open_pr_info.get("number") is not None:
            author_marker["pr_number"] = int(open_pr_info["number"])
        if session_id:
            author_marker["session_id"] = session_id
        try:
            pw.sign_marker_in_place(
                author_marker,
                hmac_secret,
                key_file=getattr(args, "key_file", None),
                require_hmac=require_hmac,
            )
        except pw.ConsensusKeyError as exc:
            print(f"paf ship ERROR: {exc}", file=sys.stderr)
            return 1
        pr_body_sections.append(f"<!-- paf-consensus: {json.dumps(author_marker, separators=(',', ':'))} -->")
    full_body = "\n\n---\n\n".join(pr_body_sections)

    pr_number: int
    pr_url: str
    if open_pr_info is not None:
        pr_number = int(open_pr_info["number"])
        pr_url = str(open_pr_info["url"])
        subprocess.run(
            ["gh", "pr", "edit", str(pr_number), "--body", full_body],
            cwd=repo,
            check=True,
            capture_output=True,
        )
    else:
        last_subject = _git(repo, "log", "-1", "--pretty=%s").stdout.strip()
        pr_title = args.title or last_subject
        create_proc = subprocess.run(
            [
                "gh",
                "pr",
                "create",
                "--base",
                base_branch,
                "--head",
                branch,
                "--title",
                pr_title,
                "--body",
                full_body,
            ],
            cwd=repo,
            text=True,
            capture_output=True,
            check=False,
        )
        if create_proc.returncode != 0:
            print(f"paf ship PR creation failed:\n{create_proc.stderr}", file=sys.stderr)
            return 1
        re_view = subprocess.run(
            ["gh", "pr", "view", branch, "--json", "number,url"],
            cwd=repo,
            text=True,
            capture_output=True,
            check=True,
        )
        info2 = json.loads(re_view.stdout)
        pr_number = int(info2["number"])
        pr_url = str(info2["url"])

    if args.open_for_consensus:
        print(f"OPENED_FOR_CONSENSUS: {pr_url} (pr=#{pr_number} head={head_sha} author={author_fam})")
        return 0

    # Step 4: Guarded non-staging branches or governance-file edits pause for Leo's single `approve`
    if requires_human_merge_approval and not args.approved_main:
        print(f"PAUSED_FOR_MAIN_APPROVAL: {pr_url} (base={base_branch} head={head_sha})")
        print(
            f"Once Leo replies 'approve' (and any stricter workspace rule is met), resume via:\n"
            f"  paf ship --repo {repo} --base {base_branch} --approved-main"
        )
        return 0

    if gov_files and not (args.approved_governance or args.approved_main):
        print(
            f"PAUSED_FOR_GOVERNANCE_APPROVAL: {pr_url} (head={head_sha}) modifies governance/permission files: "
            f"{', '.join(gov_files)}"
        )
        print(
            f"Once Leo confirms this rule/permission change, resume via:\n"
            f"  paf ship --repo {repo} --base {base_branch} --approved-governance"
        )
        return 0

    return _merge_and_verify_pr(
        repo,
        pr_number=pr_number,
        pr_url=pr_url,
        head_sha=head_sha,
        branch=branch,
        base_branch=base_branch,
        max_wait_ci=args.max_wait_ci,
        no_auto_revert=args.no_auto_revert,
    )


def _sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()[:12]


def cmd_audit(args: argparse.Namespace) -> int:
    ws = args.workspace.expanduser().resolve()
    canonical_ms_hash = _sha256_file(MEMORY_SCORING_PATH)
    rows: list[dict[str, Any]] = []

    for child in sorted(ws.iterdir()):
        if not child.is_dir() or child.name.startswith("."):
            continue
        if child.name == RESTRICTED_PRIVATE_REPO:
            # Hard boundary: inspect ONLY `.agent-factory/manifest.json` if present, nothing else.
            manifest_only = child / ".agent-factory" / "manifest.json"
            rows.append(
                {
                    "name": child.name,
                    "restricted": True,
                    "has_manifest": manifest_only.is_file(),
                    "has_instance_cfg": None,
                    "has_verify_cfg": None,
                    "has_ci": None,
                    "scoring_status": "private-boundary",
                    "max_index_bytes": None,
                    "proposals_count": None,
                }
            )
            continue

        has_git = (child / ".git").exists()
        has_manifest = (child / ".agent-factory" / "manifest.json").is_file()
        has_instance = (child / ".agent-factory" / "instance.json").is_file()
        has_verify = (child / ".agent-verify.json").is_file()
        has_ci = (child / ".github" / "workflows").is_dir() and any(
            (child / ".github" / "workflows").glob("*.y*ml")
        )

        if not (has_git or has_manifest or has_verify):
            continue

        ms_candidate = child / "scripts" / "memory_scoring.py"
        if child == FACTORY_ROOT:
            scoring_status = f"canonical({canonical_ms_hash})"
        elif ms_candidate.is_symlink():
            scoring_status = "symlink->canonical"
        elif ms_candidate.is_file():
            txt = ms_candidate.read_text(encoding="utf-8", errors="ignore")
            if "project-agent-factory/framework/scripts/memory_scoring.py" in txt:
                scoring_status = "wrapper->canonical"
            else:
                h = _sha256_file(ms_candidate)
                scoring_status = "canonical" if h == canonical_ms_hash else f"DRIFT({h})"
        else:
            scoring_status = "-"

        index_candidates = [
            child / "short-term-memory" / "_index.md",
            child / "storage" / "short_term_memory" / "_index.md",
            child / "long-term-memory" / "_index.md",
            child / "journal" / "_index.md",
        ]
        present_sizes = [p.stat().st_size for p in index_candidates if p.is_file()]
        max_idx = max(present_sizes) if present_sizes else 0

        prop_dirs = [child / "proposals", child / "framework" / "proposals"]
        prop_count = sum(
            len([f for f in pd.glob("*.md") if f.name.lower() != "readme.md"])
            for pd in prop_dirs
            if pd.is_dir()
        )

        rows.append(
            {
                "name": child.name,
                "restricted": False,
                "has_git": has_git,
                "has_manifest": has_manifest,
                "has_instance_cfg": has_instance,
                "has_verify_cfg": has_verify,
                "has_ci": has_ci,
                "scoring_status": scoring_status,
                "max_index_bytes": max_idx,
                "proposals_count": prop_count,
            }
        )

    if args.json:
        print(json.dumps(rows, indent=2))
        return 0

    header = (
        f"{'Repo':<32} {'Git':<4} {'Manif':<6} {'Verif':<6} {'CI':<4} "
        f"{'Scoring':<20} {'MaxIdx(B)':<10} {'Props':<5}"
    )
    print(header)
    print("-" * len(header))
    for r in rows:
        if r["restricted"]:
            print(
                f"{r['name']:<32} {'-':<4} {str(r['has_manifest']):<6} {'-':<6} {'-':<4} "
                f"{'private-boundary':<20} {'-':<10} {'-':<5}"
            )
            continue
        print(
            f"{r['name']:<32} {'Y' if r['has_git'] else 'N':<4} "
            f"{'Y' if r['has_manifest'] else 'N':<6} "
            f"{'Y' if r['has_verify_cfg'] else 'N':<6} "
            f"{'Y' if r['has_ci'] else 'N':<4} "
            f"{r['scoring_status']:<20} "
            f"{r['max_index_bytes']:<10} {r['proposals_count']:<5}"
        )
    return 0


def cmd_garden(args: argparse.Namespace) -> int:
    repo = args.repo.expanduser().resolve()
    dl = _load_module("dune_lint", DUNE_LINT_PATH)
    findings = dl.lint_repo(repo)
    print(f"[garden] dune_lint findings: {len(findings)}")
    for f in findings[:15]:
        print("  " + f.format())

    if (repo / ".git").exists():
        base_ref = None
        for candidate in ("origin/main", "origin/master", "main", "master"):
            if _git(repo, "rev-parse", "-q", "--verify", candidate, check=False).returncode == 0:
                base_ref = candidate
                break
        if base_ref:
            merged_out = _git(repo, "branch", "--merged", base_ref, check=False).stdout
            cur = _git_branch(repo)
            stale = []
            for line in merged_out.splitlines():
                b = line.strip().lstrip("* ").strip()
                if b and b not in ("main", "master", "stage_test", cur) and not b.startswith("("):
                    stale.append(b)
            print(f"[garden] local branches already merged into {base_ref}: {len(stale)}")
            for b in stale:
                if args.prune_merged_branches:
                    _git(repo, "branch", "-d", b, check=False)
                    print(f"  pruned: {b}")
                else:
                    print(f"  stale:  {b} (pass --prune-merged-branches to delete)")
    return 0


def cmd_init_consensus_key(args: argparse.Namespace) -> int:
    pw = _watcher_mod()
    try:
        out_path = pw.init_consensus_key(args.key_file, rotate=args.rotate)
    except pw.ConsensusKeyError as exc:
        print(f"paf init-consensus-key ERROR: {exc}", file=sys.stderr)
        return 1
    print(f"CONSENSUS_KEY_READY: {out_path} (mode 0600)")
    return 0


def cmd_watch_prs(args: argparse.Namespace) -> int:
    pw = _watcher_mod()
    repos = pw.discover_watched_repos(args.workspace, args.repo_dir)
    if not repos:
        print("paf watch-prs: zero High-Trust repos discovered.", file=sys.stderr)
        return 1
    fams = tuple(s.strip() for s in str(args.families).split(",") if s.strip())
    allow_fb: bool | None = True if args.allow_same_family_fallback else None

    while True:
        summaries = []
        for repo in repos:
            try:
                res = pw.watch_repo_once(
                    repo=repo,
                    host_id=args.host,
                    families=fams,
                    state_dir=args.state_dir,
                    key_file=args.key_file,
                    claude_model=args.claude_model,
                    agy_model=args.agy_model,
                    allow_same_family_fallback=allow_fb,
                    review_timeout_sec=args.review_timeout,
                )
                summaries.append(res)
            except Exception as exc:
                print(f"[paf watch-prs] error on {repo.name}: {exc}", file=sys.stderr)
        if args.json:
            print(json.dumps(summaries, indent=2))
        else:
            for s in summaries:
                if not s.get("not_modified"):
                    print(
                        f"[watch-prs] {s['repo']}: reviewed={s['reviewed']} "
                        f"merged={s['merged']} fixed={s['fixed']} paused={s['paused']}"
                    )
        if args.once:
            return 0
        time.sleep(max(10, int(args.interval)))


def cmd_install_watcher(args: argparse.Namespace) -> int:
    pw = _watcher_mod()
    repos = pw.discover_watched_repos(args.workspace, args.repo_dir)
    if not repos:
        print("paf install-watcher ERROR: no High-Trust repos matched.", file=sys.stderr)
        return 1
    host_id = pw.resolve_host_id(args.host)
    paf_bin = Path(__file__).resolve()
    plist_bytes = pw.build_launchd_plist(
        paf_bin=paf_bin,
        repo_dirs=repos,
        host_id=host_id,
        interval=args.interval,
        families=args.families,
        label=args.label,
        state_dir=args.state_dir,
        key_file=args.key_file,
    )
    out_path = (
        args.plist_out.expanduser().resolve()
        if args.plist_out is not None
        else (Path.home() / "Library" / "LaunchAgents" / f"{args.label}.plist")
    )
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_bytes(plist_bytes)

    if args.dry_run:
        print(f"DRY_RUN_WATCHER_PLIST_WRITTEN: {out_path} (host={host_id}, repos={len(repos)})")
        return 0

    st_dir = (args.state_dir or pw.DEFAULT_STATE_DIR).expanduser().resolve()
    (st_dir / "logs").mkdir(parents=True, exist_ok=True)
    uid = os.getuid()
    subprocess.run(
        ["launchctl", "bootout", f"gui/{uid}/{args.label}"],
        capture_output=True,
        text=True,
        check=False,
    )
    boot = subprocess.run(
        ["launchctl", "bootstrap", f"gui/{uid}", str(out_path)],
        capture_output=True,
        text=True,
        check=False,
    )
    if boot.returncode != 0:
        print(f"paf install-watcher launchctl bootstrap failed:\n{boot.stderr}", file=sys.stderr)
        return 1
    print(f"INSTALLED_AND_LOADED_WATCHER: {out_path} (gui/{uid}/{args.label})")
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="paf", description=__doc__)
    sub = p.add_subparsers(dest="subcommand", required=True)

    s_score = sub.add_parser("score", help="rebuild memory scores and clamped indexes")
    s_score.add_argument("--dir", type=Path, default=Path.cwd())
    s_score.add_argument("--stats", action="store_true")
    s_score.set_defaults(func=cmd_score)

    s_lint = sub.add_parser("lint-code", help="run Dune Architecture static checks")
    s_lint.add_argument("--repo", type=Path, default=Path.cwd())
    s_lint.add_argument("--changed-only", action="store_true")
    s_lint.add_argument("--json", action="store_true")
    s_lint.set_defaults(func=cmd_lint_code)

    s_ver = sub.add_parser("verify", help="execute .agent-verify.json gates")
    s_ver.add_argument("--repo", type=Path, default=Path.cwd())
    s_ver.add_argument("--mode", choices=("pre-push", "ci", "post-merge"), default="pre-push")
    s_ver.add_argument("--artifact", type=Path, default=None)
    s_ver.add_argument("--markdown", type=Path, default=None)
    s_ver.set_defaults(func=cmd_verify)

    s_rev = sub.add_parser("record-review", help="record SHA-pinned Blind Review receipt")
    s_rev.add_argument("--repo", type=Path, default=Path.cwd())
    s_rev.add_argument("--verdict", choices=("approve", "request_changes"), required=True)
    s_rev.add_argument("--reviewer", required=True)
    s_rev.add_argument("--summary", required=True)
    s_rev.add_argument("--findings-json", default=None)
    s_rev.set_defaults(func=cmd_record_review)

    s_chk_c = sub.add_parser("check-consensus", help="check SHA-pinned heterogeneous dual-model PR consensus")
    s_chk_c.add_argument("--repo", type=Path, default=Path.cwd())
    s_chk_c.add_argument("--pr", default=None)
    s_chk_c.add_argument("--pr-fixture", type=Path, default=None)
    s_chk_c.add_argument("--author-family", default=None)
    s_chk_c.add_argument("--max-rounds", type=int, default=None)
    s_chk_c.add_argument("--key-file", type=Path, default=None)
    s_chk_c.add_argument("--require-hmac", action="store_true")
    s_chk_c.add_argument("--allow-same-family-fallback", action="store_true")
    s_chk_c.add_argument("--json", action="store_true")
    s_chk_c.set_defaults(func=cmd_check_consensus)

    s_pst_c = sub.add_parser("post-consensus", help="post SHA-pinned consensus marker comment on a PR")
    s_pst_c.add_argument("--repo", type=Path, default=Path.cwd())
    s_pst_c.add_argument("--pr", required=True)
    s_pst_c.add_argument("--pr-fixture", type=Path, default=None)
    s_pst_c.add_argument("--role", choices=("author", "reviewer"), default="reviewer")
    s_pst_c.add_argument("--family", required=True)
    s_pst_c.add_argument("--verdict", choices=("open", "approve", "request_changes"), required=True)
    s_pst_c.add_argument("--head-sha", default=None)
    s_pst_c.add_argument("--round", type=int, default=1)
    s_pst_c.add_argument("--blocking-count", type=int, default=0)
    s_pst_c.add_argument("--needs-human-decision", action="store_true")
    s_pst_c.add_argument("--session-id", default=None)
    s_pst_c.add_argument("--host", default=None)
    s_pst_c.add_argument("--key-file", type=Path, default=None)
    s_pst_c.add_argument("--fallback-same-family", action="store_true")
    s_pst_c.add_argument("--require-hmac", action="store_true")
    s_pst_c.add_argument("--allow-same-family-fallback", action="store_true")
    s_pst_c.add_argument("--body", default=None)
    s_pst_c.add_argument("--body-file", type=Path, default=None)
    s_pst_c.add_argument("--auto-merge", action="store_true")
    s_pst_c.add_argument("--author-family", default=None)
    s_pst_c.add_argument("--max-rounds", type=int, default=None)
    s_pst_c.add_argument("--approved-main", action="store_true")
    s_pst_c.add_argument("--approved-governance", action="store_true")
    s_pst_c.add_argument("--max-wait-ci", type=int, default=600)
    s_pst_c.add_argument("--no-auto-revert", action="store_true")
    s_pst_c.set_defaults(func=cmd_post_consensus)

    s_mrg_c = sub.add_parser("merge-consensus", help="merge PR atomically once heterogeneous consensus + CI pass")
    s_mrg_c.add_argument("--repo", type=Path, default=Path.cwd())
    s_mrg_c.add_argument("--pr", default=None)
    s_mrg_c.add_argument("--pr-fixture", type=Path, default=None)
    s_mrg_c.add_argument("--author-family", default=None)
    s_mrg_c.add_argument("--max-rounds", type=int, default=None)
    s_mrg_c.add_argument("--key-file", type=Path, default=None)
    s_mrg_c.add_argument("--require-hmac", action="store_true")
    s_mrg_c.add_argument("--allow-same-family-fallback", action="store_true")
    s_mrg_c.add_argument("--approved-main", action="store_true")
    s_mrg_c.add_argument("--approved-governance", action="store_true")
    s_mrg_c.add_argument("--max-wait-ci", type=int, default=600)
    s_mrg_c.add_argument("--no-auto-revert", action="store_true")
    s_mrg_c.add_argument("--dry-run", action="store_true")
    s_mrg_c.set_defaults(func=cmd_merge_consensus)

    s_ship = sub.add_parser("ship", help="autonomous PR + CI + Consensus / Blind Review + merge + post-merge loop")
    s_ship.add_argument("--repo", type=Path, default=Path.cwd())
    s_ship.add_argument("--base", default=None)
    s_ship.add_argument("--title", default=None)
    s_ship.add_argument("--body", default=None)
    s_ship.add_argument("--pr-fixture", type=Path, default=None)
    s_ship.add_argument("--open-for-consensus", action="store_true")
    s_ship.add_argument("--author-family", default=None)
    s_ship.add_argument("--session-id", default=None)
    s_ship.add_argument("--host", default=None)
    s_ship.add_argument("--key-file", type=Path, default=None)
    s_ship.add_argument("--approved-main", action="store_true")
    s_ship.add_argument("--approved-governance", action="store_true")
    s_ship.add_argument("--allow-update-pr", action="store_true")
    s_ship.add_argument("--allow-cross-host", action="store_true")
    s_ship.add_argument("--max-wait-ci", type=int, default=600)
    s_ship.add_argument("--no-auto-revert", action="store_true")
    s_ship.add_argument("--dry-run", action="store_true")
    s_ship.set_defaults(func=cmd_ship)

    s_key = sub.add_parser("init-consensus-key", help="generate or rotate 0600 HMAC-SHA256 consensus key")
    s_key.add_argument("--key-file", type=Path, default=None)
    s_key.add_argument("--rotate", action="store_true")
    s_key.set_defaults(func=cmd_init_consensus_key)

    s_watch = sub.add_parser("watch-prs", help="ETag/state-driven dual-model PR consensus watcher")
    s_watch.add_argument("--workspace", type=Path, default=FACTORY_ROOT.parent)
    s_watch.add_argument("--repo-dir", type=Path, action="append", default=None)
    s_watch.add_argument("--host", default=None)
    s_watch.add_argument("--families", default="claude,gemini")
    s_watch.add_argument("--state-dir", type=Path, default=None)
    s_watch.add_argument("--key-file", type=Path, default=None)
    s_watch.add_argument("--claude-model", default=None)
    s_watch.add_argument("--agy-model", default=None)
    s_watch.add_argument("--allow-same-family-fallback", action="store_true")
    s_watch.add_argument("--review-timeout", type=int, default=660)
    s_watch.add_argument("--interval", type=int, default=45)
    s_watch.add_argument("--once", action="store_true")
    s_watch.add_argument("--json", action="store_true")
    s_watch.set_defaults(func=cmd_watch_prs)

    s_inst = sub.add_parser("install-watcher", help="generate or install launchd plist for paf watch-prs")
    s_inst.add_argument("--workspace", type=Path, default=FACTORY_ROOT.parent)
    s_inst.add_argument("--repo-dir", type=Path, action="append", default=None)
    s_inst.add_argument("--host", default=None)
    s_inst.add_argument("--families", default="claude,gemini")
    s_inst.add_argument("--interval", type=int, default=45)
    s_inst.add_argument("--label", default="com.leo.paf-watcher")
    s_inst.add_argument("--state-dir", type=Path, default=None)
    s_inst.add_argument("--key-file", type=Path, default=None)
    s_inst.add_argument("--plist-out", type=Path, default=None)
    s_inst.add_argument("--dry-run", action="store_true")
    s_inst.set_defaults(func=cmd_install_watcher)

    s_aud = sub.add_parser("audit", help="audit agent and product repos across workspace")
    s_aud.add_argument(
        "--workspace",
        type=Path,
        default=FACTORY_ROOT.parent,
    )
    s_aud.add_argument("--json", action="store_true")
    s_aud.set_defaults(func=cmd_audit)

    s_gar = sub.add_parser("garden", help="scan repo hygiene and stale merged branches")
    s_gar.add_argument("--repo", type=Path, default=Path.cwd())
    s_gar.add_argument("--prune-merged-branches", action="store_true")
    s_gar.set_defaults(func=cmd_garden)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return int(args.func(args))


if __name__ == "__main__":
    sys.exit(main())
